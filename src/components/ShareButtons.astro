---
/**
 * 分享按钮组件（全局）
 * 极简设计：点一下就走，不让用户二次选择 
 *
 * 逻辑：
 * - 优先复制链接 + toast 提示（最稳，全端可用）
 * - 复制失败时弹一个全屏蒙层,让用户长按复制（兜底）
 */
---

<!-- ============ 浮动分享按钮（仅文章详情页显示）============ -->
<button class="share-fab" id="shareFab" aria-label="分享" title="分享这篇文章">
  <span class="share-fab-icon">↗</span>
  <span class="share-fab-text">分享</span>
</button>

<!-- ============ 极简 toast 提示（默认用这个）============ -->
<div class="share-toast" id="shareToast" aria-hidden="true">
  <span class="share-toast-icon">📱</span>
  <span class="share-toast-text" id="shareToastText">用手机扫码分享</span>
  <span class="share-toast-url" id="shareToastUrl"></span>
</div>

<!-- ============ 兜底蒙层（极少数情况下用）============ -->
<div class="share-fallback" id="shareFallback" aria-hidden="true">
  <div class="share-fallback-box">
    <div class="share-fallback-tip">长按下面这段文字 → 复制</div>
    <div class="share-fallback-url" id="shareFallbackUrl"></div>
    <button class="share-fallback-close" id="shareFallbackClose">关闭</button>
  </div>
</div>

<!-- ============ 样式 ============ -->
<style is:global>
  /* 浮动按钮 */
  .share-fab {
    position: fixed;
    top: 86px;
    right: 24px;
    z-index: 90;
    background: var(--card-bg);
    color: var(--text);
    border: 1px solid var(--paper);
    border-radius: 20px;
    padding: 8px 14px 8px 12px;
    font-size: 13px;
    font-family: inherit;
    cursor: pointer;
    box-shadow: 1px 1px 0 var(--paper);
    display: flex;
    align-items: center;
    gap: 4px;
    transition: all 0.2s;
  }
  .share-fab:hover {
    border-color: var(--accent);
    color: var(--accent);
    box-shadow: 2px 2px 0 var(--accent);
    transform: translate(-1px, -1px);
  }
  .share-fab-icon { font-size: 16px; font-weight: 700; }
  .share-fab-text { font-weight: 500; }
  @media (max-width: 767px) {
    .share-fab {
      top: auto;
      bottom: calc(var(--nav-height, 64px) + 12px);
      right: 12px;
      padding: 10px 14px;
      border-radius: 22px;
    }
  }

  /* toast 提示（默认用这个）*/
  .share-toast {
    position: fixed;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) scale(0.9);
    z-index: 9999;
    background: rgba(40, 36, 32, 0.95);
    color: #fff;
    padding: 18px 24px;
    border-radius: 12px;
    font-size: 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    max-width: 360px;
    width: calc(100% - 40px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s, transform 0.2s;
  }
  .share-toast.is-show {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  .share-toast-icon { font-size: 28px; }
  .share-toast-text { font-weight: 500; }
  .share-toast-url {
    font-size: 11.5px;
    color: rgba(255, 255, 255, 0.75);
    word-break: break-all;
    text-align: center;
    line-height: 1.5;
    max-height: 60px;
    overflow: hidden;
  }

  /* 兜底蒙层 */
  .share-fallback {
    position: fixed;
    inset: 0;
    z-index: 10000;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
  }
  .share-fallback.is-show {
    opacity: 1;
    pointer-events: auto;
  }
  .share-fallback-box {
    background: #fff;
    border-radius: 12px;
    padding: 24px 20px;
    max-width: 320px;
    width: calc(100% - 40px);
    text-align: center;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
  }
  .share-fallback-tip {
    font-size: 14px;
    color: #333;
    margin-bottom: 12px;
    font-weight: 500;
  }
  .share-fallback-url {
    font-size: 13px;
    color: #555;
    background: #f5f5f5;
    padding: 12px;
    border-radius: 6px;
    word-break: break-all;
    line-height: 1.6;
    user-select: all;
    -webkit-user-select: all;
    margin-bottom: 16px;
  }
  .share-fallback-close {
    background: var(--accent, #5a7a4f);
    color: #fff;
    border: none;
    padding: 8px 24px;
    border-radius: 18px;
    font-size: 13px;
    cursor: pointer;
    font-family: inherit;
  }
  .share-fallback-close:hover { opacity: 0.9; }
</style>

<!-- ============ 脚本 ============ -->
<script is:inline>
  (function() {
    const fab = document.getElementById('shareFab');
    const toast = document.getElementById('shareToast');
    const toastText = document.getElementById('shareToastText');
    const toastUrl = document.getElementById('shareToastUrl');
    const fallback = document.getElementById('shareFallback');
    const fallbackUrl = document.getElementById('shareFallbackUrl');
    const fallbackClose = document.getElementById('shareFallbackClose');
    if (!fab) return;

    const pageUrl = window.location.href;
    const pageTitle = document.title;
    const pageDesc = (document.querySelector('meta[name="description"]') || {}).content || '';

    function showToast(text, withUrl) {
      toastText.textContent = text;
      toastUrl.textContent = withUrl || '';
      toastUrl.style.display = withUrl ? 'block' : 'none';
      toast.classList.add('is-show');
      toast.setAttribute('aria-hidden', 'false');
      clearTimeout(toast._t);
      toast._t = setTimeout(() => {
        toast.classList.remove('is-show');
        toast.setAttribute('aria-hidden', 'true');
      }, 4000);
    }

    function showFallback() {
      fallbackUrl.textContent = pageUrl;
      fallback.classList.add('is-show');
      fallback.setAttribute('aria-hidden', 'false');
    }
    function hideFallback() {
      fallback.classList.remove('is-show');
      fallback.setAttribute('aria-hidden', 'true');
    }

    // 关闭蒙层
    if (fallbackClose) {
      fallbackClose.addEventListener('click', hideFallback);
    }
    if (fallback) {
      fallback.addEventListener('click', (e) => {
        if (e.target === fallback) hideFallback();
      });
    }

    // 1) 优先用现代 Clipboard API
    async function tryClipboard() {
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(pageUrl);
          return true;
        }
      } catch (e) { /* fall through */ }
      return false;
    }

    // 2) 退到 textarea + execCommand('copy')
    function tryExecCommand() {
      try {
        const ta = document.createElement('textarea');
        ta.value = pageUrl;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        ta.style.pointerEvents = 'none';
        document.body.appendChild(ta);
        ta.focus();
        ta.select();
        const ok = document.execCommand('copy');
        document.body.removeChild(ta);
        return ok;
      } catch (e) { return false; }
    }

    async function copyAndToast() {
      // 1) 试 Clipboard API
      if (await tryClipboard()) {
        showToast('✅ 链接已复制,去微信粘贴吧', pageUrl);
        return;
      }
      // 2) 试 execCommand
      if (tryExecCommand()) {
        showToast('✅ 链接已复制,去微信粘贴吧', pageUrl);
        return;
      }
      // 3) 都不行 → 弹蒙层让用户长按复制
      showFallback();
    }

    fab.addEventListener('click', async (e) => {
      e.preventDefault();

      // 1) 优先 navigator.share(支持系统分享面板 → 微信带题图小卡片)
      if (navigator.share) {
        try {
          await navigator.share({
            title: pageTitle,
            text: pageDesc,
            url: pageUrl
          });
          return; // 用户已完成分享,不弹 toast
        } catch (err) {
          // 用户取消(AbortError)不弹,真失败才降级
          if (err && err.name === 'AbortError') return;
        }
      }

      // 2) 降级到复制(国内浏览器 / 桌面浏览器)
      await copyAndToast();
    });
  })();
</script>
