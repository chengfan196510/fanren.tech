---
/**
 * 分享按钮组件（全局）
 * 自动出现在每个页面的正文下方 + 详情页浮动按钮
 *
 * 设计原则：
 * - 移动端：调 navigator.share() 唤起系统分享面板（微信/钉钉/小红书都在里面）
 * - 桌面端：弹二维码 + 复制链接 + 微博/QQ 直跳
 */
const siteOrigin = Astro.site?.origin ?? 'https://fanren.tech';
const pageUrl = siteOrigin + Astro.url.pathname;
const pageTitle = Astro.props.title || '凡耘手记';
const pageDescription = Astro.props.description || '';
---

<!-- ============ 详情页浮动分享按钮（仅当 type === 'article' 时显示）============ -->
{Astro.props.type === 'article' && (
  <button class="share-fab" id="shareFab" aria-label="分享" title="分享这篇文章">
    <span class="share-fab-icon">↗</span>
    <span class="share-fab-text">分享</span>
  </button>
)}

<!-- ============ 分享弹窗（复用）============ -->
<div class="share-modal" id="shareModal" aria-hidden="true">
  <div class="share-modal-backdrop" id="shareModalBackdrop"></div>
  <div class="share-modal-content" role="dialog" aria-modal="true" aria-label="分享到">
    <div class="share-modal-header">
      <span class="share-modal-title">📤 分享到</span>
      <button class="share-modal-close" id="shareModalClose" aria-label="关闭">×</button>
    </div>

    <div class="share-modal-body">
      <!-- 移动端会显示这个按钮：调起系统原生分享 -->
      <button class="share-btn share-btn-native" id="shareNative">
        <span class="share-btn-icon">📲</span>
        <span class="share-btn-text">系统分享</span>
        <span class="share-btn-hint">微信/钉钉/小红书都在这里</span>
      </button>

      <div class="share-divider"><span>或</span></div>

      <!-- 微信专属：二维码 + 长按识别 -->
      <div class="share-qrcode-wrap">
        <p class="share-qrcode-label">微信扫一扫</p>
        <div class="share-qrcode" id="shareQrcode"></div>
        <p class="share-qrcode-hint">用微信扫一扫即可分享</p>
      </div>

      <div class="share-divider"><span>其他</span></div>

      <div class="share-btn-grid">
        <button class="share-btn" data-action="wechat-friend" id="shareWechatFriend">
          <span class="share-btn-icon" style="color:#07c160">💬</span>
          <span class="share-btn-text">微信好友</span>
        </button>
        <button class="share-btn" data-action="wechat-moments" id="shareWechatMoments">
          <span class="share-btn-icon" style="color:#07c160">👥</span>
          <span class="share-btn-text">朋友圈</span>
        </button>
        <button class="share-btn" data-action="dingtalk" id="shareDingtalk">
          <span class="share-btn-icon" style="color:#0089ff">📘</span>
          <span class="share-btn-text">钉钉</span>
        </button>
        <a class="share-btn" href={`https://service.weibo.com/share/share.php?url=${encodeURIComponent(pageUrl)}&title=${encodeURIComponent(pageTitle)}`} target="_blank" rel="noopener">
          <span class="share-btn-icon" style="color:#e6162d">🟧</span>
          <span class="share-btn-text">微博</span>
        </a>
        <a class="share-btn" href={`https://connect.qq.com/widget/shareqq/index.html?url=${encodeURIComponent(pageUrl)}&title=${encodeURIComponent(pageTitle)}&summary=${encodeURIComponent(pageDescription)}`} target="_blank" rel="noopener">
          <span class="share-btn-icon" style="color:#12B7F5">🐧</span>
          <span class="share-btn-text">QQ</span>
        </a>
        <a class="share-btn" href={`https://qr.jirengu.com/api/qr?url=${encodeURIComponent(pageUrl)}&size=200`} target="_blank" rel="noopener">
          <span class="share-btn-icon" style="color:#ff2442">📕</span>
          <span class="share-btn-text">小红书</span>
        </a>
        <button class="share-btn" data-action="copy" id="shareCopy">
          <span class="share-btn-icon" style="color:#6b6660">🔗</span>
          <span class="share-btn-text">复制链接</span>
        </button>
        <button class="share-btn" data-action="email" id="shareEmail">
          <span class="share-btn-icon" style="color:#2874a6">✉️</span>
          <span class="share-btn-text">邮件</span>
        </button>
      </div>

      <p class="share-tip" id="shareTip"></p>
    </div>
  </div>
</div>

<!-- ============ 样式 ============ -->
<style is:global>
  /* ===== 浮动分享按钮（详情页右上角）===== */
  .share-fab {
    position: fixed;
    top: 86px;
    right: 24px;
    z-index: 90;
    background: var(--card-bg);
    color: var(--text);
    border: 1px solid var(--paper);
    border-radius: 20px;
    padding: 8px 14px 8px 12px;
    font-size: 13px;
    font-family: inherit;
    cursor: pointer;
    box-shadow: 1px 1px 0 var(--paper);
    display: flex;
    align-items: center;
    gap: 4px;
    transition: all 0.2s;
  }
  .share-fab:hover {
    border-color: var(--accent);
    color: var(--accent);
    box-shadow: 2px 2px 0 var(--accent);
    transform: translate(-1px, -1px);
  }
  .share-fab-icon { font-size: 16px; font-weight: 700; }
  .share-fab-text { font-weight: 500; }
  @media (max-width: 767px) {
    .share-fab {
      top: auto;
      bottom: calc(var(--nav-height, 64px) + 12px);
      right: 12px;
      padding: 10px 14px;
      border-radius: 22px;
    }
  }

  /* ===== 弹窗 ===== */
  .share-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: flex-end;
    justify-content: center;
  }
  .share-modal.is-open { display: flex; }
  @media (min-width: 768px) {
    .share-modal { align-items: center; }
  }

  .share-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    animation: shareFadeIn 0.2s ease;
  }

  .share-modal-content {
    position: relative;
    background: var(--card-bg);
    width: 100%;
    max-width: 440px;
    max-height: 90vh;
    overflow-y: auto;
    border-radius: 16px 16px 0 0;
    box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.12);
    animation: shareSlideUp 0.25s ease;
  }
  @media (min-width: 768px) {
    .share-modal-content {
      border-radius: 12px;
      animation: shareZoomIn 0.2s ease;
    }
  }

  @keyframes shareFadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes shareSlideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
  @keyframes shareZoomIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }

  .share-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid var(--paper);
  }
  .share-modal-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
  }
  .share-modal-close {
    background: none;
    border: none;
    font-size: 24px;
    color: var(--text-fade);
    cursor: pointer;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    line-height: 1;
  }
  .share-modal-close:hover {
    background: var(--paper);
    color: var(--text);
  }

  .share-modal-body {
    padding: 20px 20px 24px;
  }

  /* ===== 系统分享按钮（移动端突出）===== */
  .share-btn-native {
    width: 100%;
    background: linear-gradient(135deg, #c0392b 0%, #a93226 100%);
    color: white;
    border: none;
    border-radius: 10px;
    padding: 14px;
    font-family: inherit;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-bottom: 8px;
    transition: transform 0.15s;
  }
  .share-btn-native:hover { transform: translateY(-1px); }
  .share-btn-native:active { transform: scale(0.98); }
  .share-btn-native .share-btn-icon { font-size: 22px; }
  .share-btn-native .share-btn-text { font-size: 15px; font-weight: 600; }
  .share-btn-native .share-btn-hint { font-size: 11px; opacity: 0.85; }

  /* ===== 二维码区 ===== */
  .share-qrcode-wrap {
    text-align: center;
    padding: 12px 0;
  }
  .share-qrcode-label {
    font-size: 13px;
    color: var(--text-light);
    margin-bottom: 10px;
  }
  .share-qrcode {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 168px;
    height: 168px;
    background: white;
    border: 1px solid var(--paper);
    border-radius: 8px;
    padding: 8px;
    margin: 0 auto;
  }
  .share-qrcode canvas,
  .share-qrcode img {
    display: block !important;
    width: 152px !important;
    height: 152px !important;
  }
  .share-qrcode-hint {
    font-size: 11.5px;
    color: var(--text-fade);
    margin-top: 8px;
  }

  /* ===== 分隔线 ===== */
  .share-divider {
    display: flex;
    align-items: center;
    margin: 16px 0;
    color: var(--text-fade);
    font-size: 11.5px;
  }
  .share-divider::before,
  .share-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--paper);
  }
  .share-divider span { padding: 0 12px; }

  /* ===== 平台按钮网格 ===== */
  .share-btn-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }
  @media (max-width: 480px) {
    .share-btn-grid { grid-template-columns: repeat(4, 1fr); gap: 6px; }
  }

  .share-btn {
    background: var(--card-bg);
    border: 1px solid var(--paper);
    border-radius: 10px;
    padding: 12px 4px 10px;
    font-family: inherit;
    cursor: pointer;
    text-decoration: none;
    color: var(--text);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    transition: all 0.15s;
  }
  .share-btn:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .share-btn:active { transform: scale(0.96); }
  .share-btn-icon { font-size: 22px; line-height: 1; }
  .share-btn-text { font-size: 11.5px; color: var(--text-light); }

  /* ===== 提示条 ===== */
  .share-tip {
    margin-top: 12px;
    padding: 0;
    text-align: center;
    font-size: 12px;
    color: var(--olive);
    min-height: 18px;
    transition: all 0.2s;
  }
  .share-tip.is-show {
    padding: 8px 12px;
    background: var(--olive-soft);
    border-radius: 6px;
  }
</style>

<!-- ============ 脚本（只在这一个组件内 inline，CDN 引入 qrcodejs）============ -->
<script is:inline>
  (function() {
    const pageUrl = window.location.href;
    const pageTitle = document.title;
    const pageDesc = (document.querySelector('meta[name="description"]') || {}).content || '';

    // ===== 工具：注入 QRCode 库（仅首次）=====
    let qrcodeLoaded = false;
    function loadQRCode() {
      return new Promise((resolve, reject) => {
        if (qrcodeLoaded && window.QRCode) return resolve();
        const s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js';
        s.onload = () => { qrcodeLoaded = true; resolve(); };
        s.onerror = reject;
        document.head.appendChild(s);
      });
    }

    // ===== 工具：弹窗控制 =====
    const modal = document.getElementById('shareModal');
    const backdrop = document.getElementById('shareModalBackdrop');
    const closeBtn = document.getElementById('shareModalClose');
    let qrcodeInstance = null;

    function openShare() {
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      // 加载并生成二维码
      loadQRCode().then(() => {
        const box = document.getElementById('shareQrcode');
        if (box) {
          box.innerHTML = '';
          qrcodeInstance = new QRCode(box, {
            text: pageUrl,
            width: 152,
            height: 152,
            colorDark: '#1a1a1a',
            colorLight: '#ffffff',
            correctLevel: QRCode.CorrectLevel.M,
          });
        }
      }).catch(() => {
        const box = document.getElementById('shareQrcode');
        if (box) box.innerHTML = '<a href="' + pageUrl + '" target="_blank" style="font-size:11px;color:#2874a6;word-break:break-all;padding:8px;">点击打开链接</a>';
      });
    }

    function closeShare() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function showTip(msg, isError) {
      const tip = document.getElementById('shareTip');
      if (!tip) return;
      tip.textContent = msg;
      tip.classList.add('is-show');
      tip.style.color = isError ? '#c0392b' : '';
      tip.style.background = isError ? '#f3d9d3' : '';
      clearTimeout(tip._t);
      tip._t = setTimeout(() => {
        tip.classList.remove('is-show');
        setTimeout(() => { tip.textContent = ''; }, 200);
      }, 2200);
    }

    // ===== 绑定事件 =====
    const fab = document.getElementById('shareFab');
    if (fab) fab.addEventListener('click', openShare);
    if (closeBtn) closeBtn.addEventListener('click', closeShare);
    if (backdrop) backdrop.addEventListener('click', closeShare);

    // ESC 关闭
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) closeShare();
    });

    // ===== 系统分享（手机用）=====
    const nativeBtn = document.getElementById('shareNative');
    if (nativeBtn) {
      nativeBtn.addEventListener('click', async () => {
        if (navigator.share) {
          try {
            await navigator.share({
              title: pageTitle,
              text: pageDesc,
              url: pageUrl,
            });
            closeShare();
          } catch (e) {
            if (e.name !== 'AbortError') showTip('分享失败,请尝试下方按钮', true);
          }
        } else {
          showTip('当前浏览器不支持系统分享,请用下方按钮');
        }
      });
    }

    // ===== 微信好友：引导扫码 =====
    document.getElementById('shareWechatFriend')?.addEventListener('click', () => {
      // 滚动到二维码位置
      const qr = document.getElementById('shareQrcode');
      if (qr) qr.scrollIntoView({ behavior: 'smooth', block: 'center' });
      showTip('👆 用微信「扫一扫」识别二维码');
    });

    // ===== 朋友圈：生成图片提示 =====
    document.getElementById('shareWechatMoments')?.addEventListener('click', () => {
      const qr = document.getElementById('shareQrcode');
      if (qr) qr.scrollIntoView({ behavior: 'smooth', block: 'center' });
      showTip('👆 截图本页 → 打开微信朋友圈 → 长按相册发布');
    });

    // ===== 钉钉：尝试唤起 app =====
    document.getElementById('shareDingtalk')?.addEventListener('click', () => {
      const dingtalkUrl = `dingtalk://dingtalkclient/page/link?url=${encodeURIComponent(pageUrl)}&pc_slide=false`;
      const start = Date.now();
      window.location.href = dingtalkUrl;
      setTimeout(() => {
        // 如果 1.5s 后页面没切走,说明没装钉钉
        if (Date.now() - start < 1800 && document.visibilityState === 'visible') {
          showTip('未检测到钉钉,可手动复制链接到钉钉');
        }
      }, 1500);
    });

    // ===== 复制链接 =====
    document.getElementById('shareCopy')?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pageUrl);
        showTip('✅ 链接已复制,去 app 粘贴吧');
      } catch (e) {
        // fallback：选中文本
        const ta = document.createElement('textarea');
        ta.value = pageUrl;
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand('copy');
          showTip('✅ 链接已复制');
        } catch (e2) {
          showTip('复制失败,请手动选择地址栏', true);
        }
        document.body.removeChild(ta);
      }
    });

    // ===== 邮件 =====
    document.getElementById('shareEmail')?.addEventListener('click', () => {
      window.location.href = `mailto:?subject=${encodeURIComponent(pageTitle)}&body=${encodeURIComponent(pageDesc + '\n\n' + pageUrl)}`;
    });
  })();
</script>
