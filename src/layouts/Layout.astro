---
import ShareButtons from '../components/ShareButtons.astro';
const {
  title,
  description = '程凡的退休闲书博客 - 杏坛拾器、数码体验、新知科普、退休日记',
  image = '/avatar.jpg',
  type = 'website',
  publishedTime,
  author = '程凡',
} = Astro.props;

// 把封面图处理成绝对 URL（微信、Twitter、Facebook 都要求绝对地址）
const siteOrigin = Astro.site?.origin ?? 'https://fanren.tech';
const absoluteImage = image.startsWith('http') ? image : siteOrigin + image;
const pageUrl = siteOrigin + Astro.url.pathname;

const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path || currentPath === path + '/';
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5">
  <title>{title}</title>

  <!-- ===== SEO / 文章摘要（搜索结果用） ===== -->
  <meta name="description" content={description}>
  <meta name="author" content={author}>

  <!-- ===== Open Graph（微信、Facebook、知乎、微博 读这套） ===== -->
  <meta property="og:type" content={type}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={absoluteImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:url" content={pageUrl}>
  <meta property="og:site_name" content="凡耘手记">
  <meta property="og:locale" content="zh_CN">
  {publishedTime && <meta property="article:published_time" content={publishedTime}>}
  {publishedTime && <meta property="article:author" content={author}>}

  <!-- ===== Twitter Card（X / 部分博客平台读这套） ===== -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={absoluteImage}>

  <!-- 首屏关键图 preload:让浏览器在 HTML 解析时就启动下载 -->
  <link rel="preload" as="image" href="/banner.jpg" fetchpriority="high" />

  <style>
    :root {
      /* 三万风：纸感米白 + 莫兰迪暗色 */
      --bg: #f5f3ee;            /* 主背景：纸感米白 */
      --card-bg: #fbfaf6;       /* 卡片：稍亮的米白 */
      --paper: #e8e4dc;         /* 边线/分割：浅米灰 */
      --text: #1a1a1a;          /* 正文：近黑 */
      --text-light: #6b6660;    /* 次要：暖灰 */
      --text-fade: #9a948a;     /* 三级：淡灰 */
      --accent: #c0392b;        /* 强调：暗红（标题、hover） */
      --accent-soft: #f3d9d3;   /* 强调底色：浅红 */
      --olive: #7a8450;         /* 标签：橄榄绿 */
      --olive-soft: #e6e8d5;
      --ink: #2874a6;           /* 链接：墨蓝 */
      --radius: 8px;            /* 圆角：比之前小，更朴素 */
      --radius-sm: 4px;
      --max-width: 680px;
      --nav-height: 64px;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html { font-size: 16px; -webkit-text-size-adjust: 100%; }

    body {
      font-family: 'LXGW WenKai', -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.85;
      min-height: 100vh;
      /* 一点点纸纹噪点（纯 CSS，SVG 编码） */
      background-image:
        radial-gradient(rgba(0,0,0,0.012) 1px, transparent 1px),
        radial-gradient(rgba(0,0,0,0.008) 1px, transparent 1px);
      background-size: 22px 22px, 11px 11px;
      background-position: 0 0, 7px 7px;
    }

    a { color: var(--ink); text-decoration: none; }
    a:hover { color: var(--accent); }

    /* ========== Desktop：侧边栏 ========== */
    @media (min-width: 768px) {
      .wrapper {
        display: flex;
        max-width: 1080px;
        margin: 0 auto;
        min-height: 100vh;
      }

      .sidebar {
        width: 220px;
        flex-shrink: 0;
        padding: 32px 24px;
        position: sticky;
        top: 0;
        height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .site-logo--mobile { display: none !important; }

      /* 桌面侧栏：纯文字 logo（不放大图） */
      .sidebar .site-logo {
        display: block;
        text-decoration: none;
        margin-bottom: 20px;
        padding-bottom: 18px;
        border-bottom: 1px dashed var(--paper);
      }
      .sidebar .site-logo-title {
        font-size: 19px;
        font-weight: 700;
        color: var(--text);
        letter-spacing: 0.15em;
        line-height: 1.2;
      }
      .sidebar .site-logo-sub {
        margin-top: 6px;
        font-size: 11px;
        font-weight: 500;
        color: var(--text-light);
        letter-spacing: 0.08em;
      }

      .sidebar nav {
        display: flex;
        flex-direction: column;
        gap: 2px;
        margin-top: 16px;
      }

      .sidebar nav a {
        padding: 9px 12px;
        border-radius: var(--radius-sm);
        color: var(--text);
        text-decoration: none;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        transition: all 0.15s;
        border-left: 2px solid transparent;
      }

      .sidebar nav a:hover {
        background: transparent;
        color: var(--accent);
        border-left-color: var(--accent);
        padding-left: 14px;
      }

      .sidebar nav a.active {
        color: var(--accent);
        border-left-color: var(--accent);
        padding-left: 14px;
        font-weight: 500;
      }

      .sidebar nav a .icon { font-size: 16px; opacity: 0.85; }

      .sidebar .footer {
        margin-top: auto;
        font-size: 11px;
        color: var(--text-fade);
        padding-top: 24px;
        border-top: 1px dashed var(--paper);
      }

      main {
        flex: 1;
        padding: 56px 48px;
        border-left: 1px solid var(--paper);
      }

      .container { max-width: var(--max-width); margin: 0; padding: 0; }
      .bottom-nav { display: none !important; }

      /* ========== 桌面主区顶部 Banner ========== */
      .site-banner {
        position: relative;
        display: block;
        width: 100%;
        aspect-ratio: 21 / 9;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 40px;
        box-shadow: 1px 1px 0 var(--paper);
        text-decoration: none;
      }
      .site-banner-img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .site-banner-text {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-end;
        padding: 0 40px;
        background: linear-gradient(
          to right,
          transparent 0%,
          transparent 30%,
          rgba(60, 50, 35, 0.45) 65%,
          rgba(60, 50, 35, 0.78) 100%
        );
      }
      .site-banner-title {
        font-size: 38px;
        font-weight: 800;
        color: #fefaf2;
        letter-spacing: 0.25em;
        line-height: 1;
        text-shadow: 0 2px 14px rgba(40, 30, 15, 0.55);
      }
      .site-banner-sub {
        margin-top: 12px;
        font-size: 14px;
        font-weight: 500;
        color: #f5ebd3;
        letter-spacing: 0.12em;
        text-shadow: 0 2px 8px rgba(40, 30, 15, 0.65);
        text-align: right;
      }
    }

    /* ========== Mobile：底部导航 ========== */
    @media (max-width: 767px) {
      body { padding-bottom: calc(var(--nav-height) + 50px); }
      .bottom-spacer { display: none; }
      .wrapper { display: block; }
      .sidebar { display: none; }
      .site-banner { display: none; }

      .container { max-width: 100%; padding: 0 18px; }

      header {
        padding: 0 0 16px;
        text-align: center;
        position: relative;
      }
      header .site-logo {
        display: block;
        position: relative;
        width: 100%;
        aspect-ratio: 21 / 9;
        border-radius: 10px;
        overflow: hidden;
        margin: 0 auto 16px;
        box-shadow: 1px 1px 0 var(--paper);
        text-decoration: none;
      }
      header .site-logo-img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      header .site-logo-text {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: flex-end;
        padding: 10px 14px;
        background: linear-gradient(
          to bottom,
          transparent 0%,
          transparent 50%,
          rgba(250, 247, 240, 0.75) 80%,
          rgba(250, 247, 240, 0.92) 100%
        );
      }
      header .site-logo-title {
        font-size: 18px;
        font-weight: 800;
        color: #2a2418;
        letter-spacing: 0.14em;
        line-height: 1;
      }
      header .site-logo-sub {
        margin-top: 4px;
        font-size: 10.5px;
        font-weight: 500;
        color: #5a4f3e;
        letter-spacing: 0.08em;
      }

      .avatar { display: none; }
      .site-title { display: none; }
      .site-desc { display: none; }

      main { padding: 0 0 24px; }
      h1 { font-size: 18px; }
      h1 .emoji { font-size: 22px; }
      .card { padding: 16px 18px; margin-bottom: 12px; }
      .card-title { font-size: 15px; }
  
    /* 文章样式：散文（岁晚闲书） */
    .post {
      background: var(--card-bg);
      border: 1px solid var(--paper);
      border-radius: var(--radius);
      box-shadow: 1px 1px 0 var(--paper);
      padding: 22px 26px;
      margin-bottom: 24px;
    }
    @media (max-width: 767px) {
      .post { padding: 18px 18px; }
    }

    .post-title {
      font-size: 19px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    @media (min-width: 768px) { .post-title { font-size: 21px; } }

    .post-meta {
      font-size: 12px;
      color: var(--text-fade);
      margin-bottom: 18px;
      padding-bottom: 14px;
      border-bottom: 1px dashed var(--paper);
    }

    .post-cover {
      width: 100%;
      height: auto;
      border-radius: var(--radius-sm);
      border: 1px solid var(--paper);
      margin-bottom: 18px;
      display: block;
    }

    .post p {
      font-size: 14px;
      line-height: 1.9;
      color: var(--text);
      margin-bottom: 14px;
      text-indent: 2em;
    }
    @media (min-width: 768px) {
      .post p { font-size: 15px; }
    }

    .post p strong { color: var(--accent); font-weight: 500; }


    /* 文章列表卡片（栏目页用） —— 改放全局块，避免 .map 动态渲染时 scoped CID 失效 */

    /* 单篇文章页 */
    .post-full { padding: 0; }
    @media (max-width: 767px) { .post-full { padding-bottom: 120px; } }
    .post-back {
      display: inline-block;
      font-size: 13px;
      color: var(--text-light);
      text-decoration: none;
      margin-bottom: 18px;
      padding: 4px 0;
    }
    .post-back:hover { color: var(--accent); }
    .post-back-bottom { margin-top: 28px; padding-top: 18px; border-top: 1px dashed var(--paper); }

    /* 作者卡片（二维码） */
    .author-card {
      margin-top: 36px;
      padding-top: 24px;
      border-top: 1px dashed var(--paper);
    }
    .author-card-inner {
      display: flex;
      align-items: center;
      gap: 20px;
      padding: 20px 24px;
      background: var(--card-bg);
      border: 1px solid var(--paper);
      border-radius: var(--radius);
      box-shadow: 1px 1px 0 var(--paper);
    }
    .author-qr {
      width: 80px;
      height: 80px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--paper);
      flex-shrink: 0;
    }
    .author-card-text {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .author-card-name {
      font-size: 15px;
      font-weight: 600;
      color: var(--text);
      margin: 0;
      text-indent: 0;
    }
    .author-card-desc {
      font-size: 12.5px;
      color: var(--text-light);
      margin: 0;
      text-indent: 0;
    }
    @media (max-width: 767px) {
      .author-card-inner { padding: 16px 18px; gap: 16px; }
      .author-qr { width: 72px; height: 72px; }
    }

    .post-full-title {
      font-size: 22px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 8px;
    }
    @media (min-width: 768px) { .post-full-title { font-size: 26px; } }

    .post-full-meta {
      font-size: 12.5px;
      color: var(--text-fade);
      margin-bottom: 22px;
      padding-bottom: 16px;
      border-bottom: 1px dashed var(--paper);
    }

    @media (min-width: 768px) {
    }

    .post-full-content p {
      font-size: 14.5px;
      line-height: 1.95;
      color: var(--text);
      margin-bottom: 16px;
      text-indent: 2em;
    }
    @media (min-width: 768px) {
      .post-full-content p { font-size: 15.5px; }
    }
    .post-full-content p strong { color: var(--accent); font-weight: 500; }

    .about-section { padding: 18px 20px; }
      .section-title { font-size: 13px; margin: 24px 0 12px; }
      .work-in-progress { padding: 36px 20px; }
      .work-in-progress .emoji { font-size: 40px; }
    }

    @media (min-width: 480px) and (max-width: 767px) {
      .container { padding: 0 22px; }
      header { padding: 44px 0 28px; }
      .avatar { width: 68px; height: 68px; font-size: 30px; }
      .site-title { font-size: 24px; }
      h1 { font-size: 20px; }
      h1 .emoji { font-size: 26px; }
      .card { padding: 18px 20px; margin-bottom: 14px; }
      .card-title { font-size: 16px; }
    }

    /* ========== 通用元素 ========== */
    .avatar {
      width: 64px;
      height: 64px;
      object-fit: cover;
      background: #fff;
      border: 1px solid var(--paper);
      border-radius: 50%;
      display: block;
      margin: 0 auto 14px;
    }

    .site-title { font-weight: 700; margin-bottom: 4px; }
    .site-desc { color: var(--text-light); font-size: 12px; }

    header { text-align: center; }

    h1 {
      font-weight: 700;
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--text);
    }
    h1 .emoji { flex-shrink: 0; }

    .page-desc {
      font-size: 14px;
      color: var(--text-light);
      margin-bottom: 24px;
    }
    @media (min-width: 768px) { .page-desc { margin-bottom: 32px; } }

    /* 卡片：纸感，边线而非阴影 */
    .card {
      background: var(--card-bg);
      border-radius: var(--radius);
      border: 1px solid var(--paper);
      box-shadow: 1px 1px 0 var(--paper);
      transition: all 0.2s;
    }
    .card:hover {
      border-color: var(--accent);
      box-shadow: 2px 2px 0 var(--accent);
      transform: translate(-1px, -1px);
    }

    .card-title { font-weight: 500; margin-bottom: 6px; color: var(--text); }
    .card-desc { font-size: 13px; color: var(--text-light); line-height: 1.65; }

    /* 标签：橄榄绿小章 */
    .card-tag {
      display: inline-block;
      background: var(--olive-soft);
      color: var(--olive);
      padding: 2px 10px;
      border-radius: var(--radius-sm);
      font-size: 11px;
      margin-top: 10px;
      border: 1px solid transparent;
    }

    .section-title {
      color: var(--text-light);
      font-weight: 500;
      padding-left: 4px;
      font-size: 13px;
    }
    .section-title::before { content: '· '; color: var(--accent); }

    /* 物理分割：纸面折痕感 */
    .section-divider {
      display: flex;
      align-items: center;
      margin: 36px 0 24px;
      color: var(--text-light);
      font-size: 12px;
    }
    .section-divider::before,
    .section-divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--paper);
    }
    .section-divider::before { margin-right: 12px; }
    .section-divider::after { margin-left: 12px; }
    .section-divider span { letter-spacing: 0.1em; }

    /* 带图卡片：上方配图,下方文案 */
    .card-with-cover {
      display: block;
      text-decoration: none;
      color: inherit;
      background: var(--card-bg);
      border-radius: var(--radius);
      border: 1px solid var(--paper);
      box-shadow: 1px 1px 0 var(--paper);
      transition: all 0.2s;
      overflow: hidden;
    }
    .card-with-cover:hover {
      border-color: var(--accent);
      box-shadow: 2px 2px 0 var(--accent);
      transform: translate(-1px, -1px);
    }
    .card-with-cover-img {
      display: block;
      width: 100%;
      height: 160px;
      object-fit: cover;
      border-bottom: 1px solid var(--paper);
      background: var(--paper);
    }
    .card-with-cover-body {
      padding: 14px 18px 16px;
    }
    .card-with-cover .card-tag { margin-top: 12px; }

    .work-in-progress { text-align: center; color: var(--text-light); }
    .work-in-progress .emoji { margin-bottom: 14px; display: block; }
    .work-in-progress h2 { font-size: 16px; color: var(--text); margin-bottom: 6px; }
    .work-in-progress p { font-size: 13px; }


    /* 文章样式：散文（岁晚闲书） */
    .post {
      background: var(--card-bg);
      border: 1px solid var(--paper);
      border-radius: var(--radius);
      box-shadow: 1px 1px 0 var(--paper);
      padding: 22px 26px;
      margin-bottom: 24px;
    }
    @media (max-width: 767px) {
      .post { padding: 18px 18px; }
    }

    .post-title {
      font-size: 19px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    @media (min-width: 768px) { .post-title { font-size: 21px; } }

    .post-meta {
      font-size: 12px;
      color: var(--text-fade);
      margin-bottom: 18px;
      padding-bottom: 14px;
      border-bottom: 1px dashed var(--paper);
    }

    .post-cover {
      width: 100%;
      height: auto;
      border-radius: var(--radius-sm);
      border: 1px solid var(--paper);
      margin-bottom: 18px;
      display: block;
    }

    .post p {
      font-size: 14px;
      line-height: 1.9;
      color: var(--text);
      margin-bottom: 14px;
      text-indent: 2em;
    }
    @media (min-width: 768px) {
      .post p { font-size: 15px; }
    }

    .post p strong { color: var(--accent); font-weight: 500; }


    /* 单篇文章页 */
    .post-full { padding: 0; }
    @media (max-width: 767px) { .post-full { padding-bottom: 140px; } .bottom-spacer { display: block; height: 100px; } }
    .post-back {
      display: inline-block;
      font-size: 13px;
      color: var(--text-light);
      text-decoration: none;
      margin-bottom: 18px;
      padding: 4px 0;
    }
    .post-back:hover { color: var(--accent); }
    .post-back-bottom { margin-top: 28px; padding-top: 18px; border-top: 1px dashed var(--paper); }

    /* 作者卡片（二维码） */
    .author-card {
      margin-top: 36px;
      padding-top: 24px;
      border-top: 1px dashed var(--paper);
    }
    .author-card-inner {
      display: flex;
      align-items: center;
      gap: 20px;
      padding: 20px 24px;
      background: var(--card-bg);
      border: 1px solid var(--paper);
      border-radius: var(--radius);
      box-shadow: 1px 1px 0 var(--paper);
    }
    .author-qr {
      width: 80px;
      height: 80px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--paper);
      flex-shrink: 0;
    }
    .author-card-text {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .author-card-name {
      font-size: 15px;
      font-weight: 600;
      color: var(--text);
      margin: 0;
      text-indent: 0;
    }
    .author-card-desc {
      font-size: 12.5px;
      color: var(--text-light);
      margin: 0;
      text-indent: 0;
    }
    @media (max-width: 767px) {
      .author-card-inner { padding: 16px 18px; gap: 16px; }
      .author-qr { width: 72px; height: 72px; }
    }

    .post-full-title {
      font-size: 22px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 8px;
    }
    @media (min-width: 768px) { .post-full-title { font-size: 26px; } }

    .post-full-meta {
      font-size: 12.5px;
      color: var(--text-fade);
      margin-bottom: 22px;
      padding-bottom: 16px;
      border-bottom: 1px dashed var(--paper);
    }

    @media (min-width: 768px) {
    }

    .post-full-content p {
      font-size: 14.5px;
      line-height: 1.95;
      color: var(--text);
      margin-bottom: 16px;
      text-indent: 2em;
    }
    @media (min-width: 768px) {
      .post-full-content p { font-size: 15.5px; }
    }
    .post-full-content p strong { color: var(--accent); font-weight: 500; }

    .about-section {
      background: var(--card-bg);
      border-radius: var(--radius);
      border: 1px solid var(--paper);
      box-shadow: 1px 1px 0 var(--paper);
    }
    @media (max-width: 767px) { .about-section { margin-top: 20px; padding: 18px 20px; } }
    @media (min-width: 768px) { .about-section { margin-top: 28px; padding: 24px 28px; } }

    .about-section p { font-size: 13px; color: var(--text-light); line-height: 1.8; }
    @media (min-width: 768px) { .about-section p { font-size: 14px; } }

    /* 底部导航：白板风，简洁 */
    .bottom-nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: var(--card-bg);
      border-top: 1px solid var(--paper);
      display: flex;
      justify-content: space-around;
      padding: 6px 0;
      z-index: 100;
    }

    .nav-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      text-decoration: none;
      color: var(--text-light);
      font-size: 10px;
      padding: 6px 6px;
      border-radius: 6px;
      transition: all 0.15s;
      min-width: 50px;
    }
    .nav-item .icon { font-size: 18px; }
    .nav-item.active { color: var(--accent); }
    .nav-item:active { transform: scale(0.95); }

    @media (max-width: 360px) {
      .nav-item { padding: 4px 4px; min-width: 44px; font-size: 9px; }
      .nav-item .icon { font-size: 16px; }
    }
  </style>

  <style is:global>
    /* ===== 跨页生效的样式（必须在 global 块，Layout.astro 的 scoped 对子页面元素不生效）===== */

    /* 详情页阅读栏宽度 */
    .post-full-content { max-width: 640px; }

    /* 详情页 / 列表页图片统一宽度：跟正文同宽 640px,不再撑破排版 */
    .post-full-cover,
    .post-inline-figure {
      display: block;
      width: 100% !important;
      max-width: 640px !important;
      height: auto !important;
      object-fit: contain;
      object-position: center;
      border-radius: 8px;
      border: 1px solid #e8e4dc;
      margin: 0 auto 24px;
      box-sizing: border-box;
    }
    .post-inline-figure { margin: 28px auto; }
    .post-full-cover { margin: 0 auto 24px; }

    .post-inline-figure-caption {
      display: block;
      text-align: center;
      font-size: 12px;
      color: var(--text-fade);
      margin: -16px auto 24px;
      max-width: 640px;
      font-style: italic;
    }

    /* 详情页正文段落（不在 .post 内也保样式）*/
    .post-full-content p {
      font-size: 14.5px;
      line-height: 1.95;
      color: var(--text);
      margin-bottom: 16px;
      text-indent: 2em;
    }
    @media (min-width: 768px) {
      .post-full-content p { font-size: 15.5px; }
    }
    .post-full-content p strong { color: var(--accent); font-weight: 500; }

    /* ===== 文章列表卡片（全局块，避开 .map 动态渲染的 scoped CID 失效问题）===== */
    .post-card-link {
      display: block;
      text-decoration: none;
      color: inherit;
      margin-bottom: 14px;
    }
    .post-card {
      background: var(--card-bg);
      border: 1px solid #c8c2b6;
      border-radius: 6px;
      overflow: hidden;
      transition: border-color .2s ease;
    }
    .post-card-link:hover .post-card {
      border-color: var(--accent);
    }
    .post-card-body { padding: 12px 14px 14px; }
    .post-card-title {
      font-size: 16px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 4px;
    }
    .post-card-meta {
      font-size: 11.5px;
      color: var(--text-fade);
      margin-bottom: 6px;
    }
    .post-card-excerpt {
      font-size: 13px;
      color: var(--text-light);
      line-height: 1.6;
      margin-bottom: 8px;
    }
    .post-card-read {
      font-size: 12.5px;
      color: var(--accent);
      font-weight: 500;
    }

    /* ===== 卡片封面图 wrapper（必须 global，否则 scoped 失效）===== */
    .post-card > .post-card-cover {
      width: 100%;
      height: 160px;
      overflow: hidden;
      border-bottom: 1px solid #e8e4dc;
      background: #f5f3ee;
      display: block;
    }
    .post-card > .post-card-cover img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }
    .post-card > .post-card-cover--placeholder {
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 48px;
      color: #c8c2b6;
    }
    @media (min-width: 768px) {
      .post-card > .post-card-cover { height: 200px; }
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <aside class="sidebar">
      <!-- ========== 站点 Logo：纯文字 ========== -->
      <a href="/" class="site-logo">
        <div class="site-logo-title">凡耘手记</div>
        <div class="site-logo-sub">一介凡人，闲耘方寸技田</div>
      </a>

      <nav>
        <a href="/" class:list={["nav-item", { active: isActive('/') || isActive('/index') }]}>
          <span class="icon">🏠</span>
          <span>首页</span>
        </a>
        <a href="/teaching" class:list={["nav-item", { active: isActive('/teaching') }]}>
          <span class="icon">🛠️</span>
          <span>杏坛拾器</span>
        </a>
        <a href="/tech" class:list={["nav-item", { active: isActive('/tech') }]}>
          <span class="icon">📱</span>
          <span>数码闲赏</span>
        </a>
        <a href="/ai" class:list={["nav-item", { active: isActive('/ai') }]}>
          <span class="icon">🤖</span>
          <span>新知漫解</span>
        </a>
        <a href="/life" class:list={["nav-item", { active: isActive('/life') }]}>
          <span class="icon">🌿</span>
          <span>岁晚闲书</span>
        </a>
        <a href="/guestbook" class:list={["nav-item", { active: isActive('/guestbook') }]}>
          <span class="icon">💬</span>
          <span>留言板</span>
        </a>
      </nav>
      <div class="footer">
        📅 建于 2026 · 宁波
      </div>
    </aside>

    <main>
      <!-- ========== 桌面主区顶部 Banner：全站统一 ========== -->
      <a href="/" class="site-banner">
        <img src="/banner.jpg" alt="凡耘手记 — 一介凡人，闲耘方寸技田" class="site-banner-img" fetchpriority="high" decoding="async" />
        <div class="site-banner-text">
          <div class="site-banner-title">凡耘手记</div>
          <div class="site-banner-sub">一介凡人，闲耘方寸技田</div>
        </div>
      </a>

      <div class="container">
        <header>
          <!-- ========== 移动端 Logo：水彩图 + 叠字标题 ========== -->
          <a href="/" class="site-logo site-logo--mobile">
            <img src="/banner.jpg" alt="凡耘手记 — 一介凡人，闲耘方寸技田" class="site-logo-img" />
            <div class="site-logo-text">
              <div class="site-logo-title">凡耘手记</div>
              <div class="site-logo-sub">一介凡人，闲耘方寸技田</div>
            </div>
          </a>
        </header>

        <slot />

        {type === 'article' && (
          <div class="author-card">
            <div class="author-card-inner">
              <img src="/wechat-qr.jpg" alt="微信二维码" class="author-qr" />
              <div class="author-card-text">
                <p class="author-card-name">程凡</p>
                <p class="author-card-desc">闲耘方寸技田 · 扫码添加微信</p>
              </div>
            </div>
          </div>
        )}

        <div class="bottom-spacer" aria-hidden="true"></div>

        <ShareButtons title={title} description={description} type={type} />
      </div>
    </main>
  </div>

  <nav class="bottom-nav">
    <a href="/" class:list={["nav-item", { active: isActive('/') || isActive('/index') }]}>
      <span class="icon">🏠</span>
      <span>首页</span>
    </a>
    <a href="/teaching" class:list={["nav-item", { active: isActive('/teaching') }]}>
      <span class="icon">🛠️</span>
      <span>杏坛</span>
    </a>
    <a href="/tech" class:list={["nav-item", { active: isActive('/tech') }]}>
      <span class="icon">📱</span>
      <span>数码</span>
    </a>
    <a href="/ai" class:list={["nav-item", { active: isActive('/ai') }]}>
      <span class="icon">🤖</span>
      <span>新知</span>
    </a>
    <a href="/life" class:list={["nav-item", { active: isActive('/life') }]}>
      <span class="icon">🌿</span>
      <span>闲书</span>
    </a>
    <a href="/guestbook" class:list={["nav-item", { active: isActive('/guestbook') }]}>
      <span class="icon">💬</span>
      <span>留言</span>
    </a>
  </nav>
</body>

<!-- ===== 访问统计埋点（站点性能无影响，失败静默） ===== -->
<script is:inline>
(function() {
  if (typeof navigator === 'undefined' || !navigator.sendBeacon) return;
  var host = location.hostname;
  if (host === 'admin.fanren.tech') return; // 后台不统计
  var data = JSON.stringify({
    path: location.pathname + location.search,
    referer: document.referrer || ''
  });
  // admin.fanren.tech 跑统计接口，POST 失败也不影响页面
  navigator.sendBeacon('https://admin.fanren.tech/api/track', new Blob([data], {type: 'application/json'}));
})();
</script>
</html>
