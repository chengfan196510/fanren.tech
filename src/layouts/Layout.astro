---
/**
 * 全站页面布局模板 (Layout)
 * 
 * 这是凡耘手记博客的核心布局组件，所有页面都基于此模板构建
 * 包含功能：
 * - 响应式侧边栏导航（桌面端）和底部导航栏（移动端）
 * - 统一的页面头部（SEO meta 标签、Open Graph、Twitter Card）
 * - 站点 Logo 和 Banner
 * - 访问统计埋点
 * - 全站统一的视觉风格（纸感米白 + 莫兰迪暗色配色）
 */
import ShareButtons from '../components/ShareButtons.astro';

// =============================================
// Frontmatter 脚本区：接收父组件传入的属性
// =============================================

/**
 * 从父组件获取页面属性
 * 这些属性用于 SEO 元数据设置和页面渲染
 */
const {
  title,                              // 页面标题
  description = '程凡的退休闲书博客 - 杏坛拾器、数码体验、新知科普、退休日记',  // 页面描述（默认描述）
  image = '/avatar.jpg',             // 分享时显示的图片（默认头像）
  type = 'website',                  // Open Graph 类型（默认网站）
  publishedTime,                      // 文章发布时间（可选）
  author = '程凡',                    // 作者（默认程凡）
} = Astro.props;

/**
 * 处理封面图为绝对 URL
 * 微信、Twitter、Facebook 等平台要求分享图片必须是完整的绝对地址
 * 如果传入的是相对路径（如 /avatar.jpg），则拼接上站点域名
 */
const siteOrigin = Astro.site?.origin ?? 'https://fanren.tech';
const absoluteImage = image.startsWith('http') ? image : siteOrigin + image;
const pageUrl = siteOrigin + Astro.url.pathname;

/**
 * 获取当前页面路径，用于高亮当前导航项
 */
const currentPath = Astro.url.pathname;

/**
 * 判断某个路径是否为当前激活的页面
 * 同时处理带斜杠和不带斜杠两种情况
 * @param {string} path - 要检查的路径
 * @returns {boolean} - 是否为当前页面
 */
const isActive = (path: string) => currentPath === path || currentPath === path + '/';
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <!-- 基础字符编码 -->
  <meta charset="UTF-8">
  <!-- 响应式视口设置，支持移动端缩放 -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5">
  <title>{title}</title>

  <!-- ===== SEO / 搜索引擎优化 ===== -->
  <!-- description: 搜索结果摘要，影响搜索引擎显示 -->
  <meta name="description" content={description}>
  <!-- author: 文章作者 -->
  <meta name="author" content={author}>

  <!-- ===== Open Graph（社交媒体预览）====== -->
  <!-- 这套标签用于微信、Facebook、知乎、微博等平台的链接预览 -->
  <meta property="og:type" content={type}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={absoluteImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:url" content={pageUrl}>
  <meta property="og:site_name" content="凡耘手记">
  <meta property="og:locale" content="zh_CN">
  <!-- 如果有发布时间，添加 Open Graph 发布时间标签 -->
  {publishedTime && <meta property="article:published_time" content={publishedTime}>}
  {publishedTime && <meta property="article:author" content={author}>}

  <!-- ===== Twitter Card（X / Twitter 平台预览）====== -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={absoluteImage}>

  <!-- 首屏关键图预加载 -->
  <!-- 使用 preload 让浏览器在解析 HTML 时就开始下载 Banner 图，加快首屏渲染 -->
  <link rel="preload" as="image" href="/banner.jpg" fetchpriority="high" />

  <style>
    /* ==========================================
       CSS 变量：定义全站设计系统（纸感米白主题）
       ========================================== */
    :root {
      /* 主背景：纸感米白 */
      --bg: #f5f3ee;
      /* 卡片背景：稍亮的米白 */
      --card-bg: #fbfaf6;
      /* 边线/分割线：浅米灰 */
      --paper: #e8e4dc;
      /* 正文颜色：近黑 */
      --text: #1a1a1a;
      /* 次要文字：暖灰 */
      --text-light: #6b6660;
      /* 三级文字：淡灰 */
      --text-fade: #9a948a;
      /* 强调色：暗红（用于标题、hover 效果）*/
      --accent: #c0392b;
      /* 强调色浅底：浅红 */
      --accent-soft: #f3d9d3;
      /* 标签颜色：橄榄绿 */
      --olive: #7a8450;
      /* 橄榄绿浅底 */
      --olive-soft: #e6e8d5;
      /* 链接颜色：墨蓝 */
      --ink: #2874a6;
      /* 圆角变量 */
      --radius: 8px;
      --radius-sm: 4px;
      /* 正文最大宽度 */
      --max-width: 680px;
      /* 导航栏高度（移动端底部导航） */
      --nav-height: 64px;
    }

    /* 全局重置：移除浏览器默认边距 */
    * { margin: 0; padding: 0; box-sizing: border-box; }

    /* HTML 根元素设置 */
    html { font-size: 16px; -webkit-text-size-adjust: 100%; }

    /* 页面主体样式 */
    body {
      /* 使用霞鹜文楷字体，优雅的中文字体 */
      font-family: 'LXGW WenKai', -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.85;
      min-height: 100vh;
      /* 纸纹背景效果：用两个 radial-gradient 叠加出细微噪点 */
      background-image:
        radial-gradient(rgba(0,0,0,0.012) 1px, transparent 1px),
        radial-gradient(rgba(0,0,0,0.008) 1px, transparent 1px);
      background-size: 22px 22px, 11px 11px;
      background-position: 0 0, 7px 7px;
    }

    /* 链接样式 */
    a { color: var(--ink); text-decoration: none; }
    a:hover { color: var(--accent); }

    /* ==========================================
       桌面端布局（屏幕宽度 >= 768px）
       使用侧边栏导航
       ========================================== */
    @media (min-width: 768px) {
      /* 主容器：flex 布局，左右分栏 */
      .wrapper {
        display: flex;
        max-width: 1080px;
        margin: 0 auto;
        min-height: 100vh;
      }

      /* 侧边栏样式 */
      .sidebar {
        width: 220px;
        flex-shrink: 0;  /* 不允许侧边栏收缩 */
        padding: 32px 24px;
        position: sticky;  /* 固定定位，滚动时保持可见 */
        top: 0;
        height: 100vh;
        display: flex;
        flex-direction: column;  /* 垂直排列内容 */
      }

      /* 移动端 Logo 在桌面端隐藏 */
      .site-logo--mobile { display: none !important; }

      /* 桌面侧栏 Logo：纯文字风格 */
      .sidebar .site-logo {
        display: block;
        text-decoration: none;
        margin-bottom: 20px;
        padding-bottom: 18px;
        border-bottom: 1px dashed var(--paper);  /* 虚线下划线 */
      }
      .sidebar .site-logo-title {
        font-size: 19px;
        font-weight: 700;
        color: var(--text);
        letter-spacing: 0.15em;  /* 字间距 */
        line-height: 1.2;
      }
      .sidebar .site-logo-sub {
        margin-top: 6px;
        font-size: 11px;
        font-weight: 500;
        color: var(--text-light);
        letter-spacing: 0.08em;
      }

      /* 侧边栏导航菜单 */
      .sidebar nav {
        display: flex;
        flex-direction: column;
        gap: 2px;
        margin-top: 16px;
      }

      /* 导航链接样式 */
      .sidebar nav a {
        padding: 9px 12px;
        border-radius: var(--radius-sm);
        color: var(--text);
        text-decoration: none;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        transition: all 0.15s;  /* 过渡动画 */
        border-left: 2px solid transparent;  /* 左侧高亮条 */
      }

      /* 导航链接 hover 效果 */
      .sidebar nav a:hover {
        background: transparent;
        color: var(--accent);
        border-left-color: var(--accent);
        padding-left: 14px;  /* hover 时文字右移 */
      }

      /* 当前激活的导航项 */
      .sidebar nav a.active {
        color: var(--accent);
        border-left-color: var(--accent);
        padding-left: 14px;
        font-weight: 500;
      }

      /* 导航图标 */
      .sidebar nav a .icon { font-size: 16px; opacity: 0.85; }

      /* 侧边栏底部信息 */
      .sidebar .footer {
        margin-top: auto;  /* 推到最底部 */
        font-size: 11px;
        color: var(--text-fade);
        padding-top: 24px;
        border-top: 1px dashed var(--paper);
      }

      /* 主内容区 */
      main {
        flex: 1;  /* 占据剩余空间 */
        padding: 56px 48px;
        border-left: 1px solid var(--paper);  /* 与侧边栏分隔线 */
      }

      /* 内容容器 */
      .container { max-width: var(--max-width); margin: 0; padding: 0; }
      
      /* 移动端底部导航在桌面端隐藏 */
      .bottom-nav { display: none !important; }

      /* ========== 桌面主区顶部 Banner（大横幅图）========== */
      .site-banner {
        position: relative;
        display: block;
        width: 100%;
        aspect-ratio: 21 / 9;  /* 宽高比 21:9 */
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 40px;
        box-shadow: 1px 1px 0 var(--paper);
        text-decoration: none;
      }
      .site-banner-img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      /* Banner 上的文字叠加层 */
      .site-banner-text {
        position: absolute;
        inset: 0;  /* 覆盖整个父元素 */
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-end;
        padding: 0 40px;
        /* 渐变遮罩：左到右从透明渐变到深色 */
        background: linear-gradient(
          to right,
          transparent 0%,
          transparent 30%,
          rgba(60, 50, 35, 0.45) 65%,
          rgba(60, 50, 35, 0.78) 100%
        );
      }
      .site-banner-title {
        font-size: 38px;
        font-weight: 800;
        color: #fefaf2;
        letter-spacing: 0.25em;
        line-height: 1;
        text-shadow: 0 2px 14px rgba(40, 30, 15, 0.55);
      }
      .site-banner-sub {
        margin-top: 12px;
        font-size: 14px;
        font-weight: 500;
        color: #f5ebd3;
        letter-spacing: 0.12em;
        text-shadow: 0 2px 8px rgba(40, 30, 15, 0.65);
        text-align: right;
      }
    }

    /* ==========================================
       移动端布局（屏幕宽度 < 768px）
       使用底部导航栏
       ========================================== */
    @media (max-width: 767px) {
      /* 为底部导航腾出空间 */
      body { padding-bottom: var(--nav-height); }
      .wrapper { display: block; }
      .sidebar { display: none; }  /* 隐藏侧边栏 */
      .site-banner { display: none; }  /* 隐藏 Banner */

      .container { max-width: 100%; padding: 0 18px; }

      /* 移动端头部 */
      header {
        padding: 0 0 16px;
        text-align: center;
        position: relative;
      }
      /* 移动端 Logo：水彩图 + 叠字标题 */
      header .site-logo {
        display: block;
        position: relative;
        width: 100%;
        aspect-ratio: 21 / 9;
        border-radius: 10px;
        overflow: hidden;
        margin: 0 auto 16px;
        box-shadow: 1px 1px 0 var(--paper);
        text-decoration: none;
      }
      header .site-logo-img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      header .site-logo-text {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
      }
      header .site-logo-title {
        font-size: 18px;
        font-weight: 700;
        color: #fefaf2;
        letter-spacing: 0.15em;
        text-shadow: 0 2px 8px rgba(40, 30, 15, 0.55);
      }
      header .site-logo-sub {
        font-size: 10px;
        color: #f5ebd3;
        letter-spacing: 0.1em;
        text-shadow: 0 1px 4px rgba(40, 30, 15, 0.65);
        margin-top: 4px;
      }
    }

    /* ==========================================
       通用组件样式
       ========================================== */

    /* 页面大标题 */
    h1 {
      font-size: 24px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 6px;
      letter-spacing: 0.08em;
    }
    @media (min-width: 768px) { h1 { font-size: 28px; } }

    /* 页面描述文字 */
    .page-desc {
      font-size: 13px;
      color: var(--text-light);
      margin-bottom: 24px;
    }
    @media (min-width: 768px) { .page-desc { font-size: 14px; } }

    /* 段落标题 */
    .section-title {
      font-size: 15px;
      font-weight: 600;
      color: var(--text);
      margin: 32px 0 14px;
      letter-spacing: 0.06em;
    }
    @media (min-width: 768px) { .section-title { font-size: 16px; margin: 40px 0 18px; } }

    /* Emoji 图标样式（与大标题搭配） */
    .emoji { margin-right: 6px; }

    /* "正在建设中" 占位样式 */
    .work-in-progress { text-align: center; color: var(--text-light); }
    .work-in-progress .emoji { margin-bottom: 14px; display: block; }
    .work-in-progress h2 { font-size: 16px; color: var(--text); margin-bottom: 6px; }
    .work-in-progress p { font-size: 13px; }

    /* 文章样式：用于渲染 Markdown/HTML 生成的正文内容 */
    .post {
      background: var(--card-bg);
      border: 1px solid var(--paper);
      border-radius: var(--radius);
      box-shadow: 1px 1px 0 var(--paper);
      padding: 22px 26px;
      margin-bottom: 24px;
    }
    @media (max-width: 767px) { .post { padding: 18px 18px; } }

    /* 文章标题 */
    .post-title {
      font-size: 19px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    @media (min-width: 768px) { .post-title { font-size: 21px; } }

    /* 文章元信息（日期、标签等） */
    .post-meta {
      font-size: 12px;
      color: var(--text-fade);
      margin-bottom: 18px;
      padding-bottom: 14px;
      border-bottom: 1px dashed var(--paper);
    }

    /* 文章封面图 */
    .post-cover {
      width: 100%;
      height: auto;
      border-radius: var(--radius-sm);
      border: 1px solid var(--paper);
      margin-bottom: 18px;
      display: block;
    }

    /* 文章正文段落 */
    .post p {
      font-size: 14px;
      line-height: 1.9;
      color: var(--text);
      margin-bottom: 14px;
      text-indent: 2em;  /* 首行缩进两个字符 */
    }
    @media (min-width: 768px) { .post p { font-size: 15px; } }

    /* 正文中的强调文字 */
    .post p strong { color: var(--accent); font-weight: 500; }

    /* 单篇文章页（详情页） */
    .post-full { padding: 0; }
    @media (max-width: 767px) { .post-full { padding-bottom: 80px; } }

    /* 返回链接 */
    .post-back {
      display: inline-block;
      font-size: 13px;
      color: var(--text-light);
      text-decoration: none;
      margin-bottom: 18px;
      padding: 4px 0;
    }
    .post-back:hover { color: var(--accent); }
    .post-back-bottom { margin-top: 28px; padding-top: 18px; border-top: 1px dashed var(--paper); }

    /* 详情页大标题 */
    .post-full-title {
      font-size: 22px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 8px;
    }
    @media (min-width: 768px) { .post-full-title { font-size: 26px; } }

    /* 详情页元信息 */
    .post-full-meta {
      font-size: 12.5px;
      color: var(--text-fade);
      margin-bottom: 22px;
      padding-bottom: 16px;
      border-bottom: 1px dashed var(--paper);
    }

    /* 详情页正文内容 */
    .post-full-content p {
      font-size: 14.5px;
      line-height: 1.95;
      color: var(--text);
      margin-bottom: 16px;
      text-indent: 2em;
    }
    @media (min-width: 768px) { .post-full-content p { font-size: 15.5px; } }
    .post-full-content p strong { color: var(--accent); font-weight: 500; }

    /* 关于区块 */
    .about-section {
      background: var(--card-bg);
      border-radius: var(--radius);
      border: 1px solid var(--paper);
      box-shadow: 1px 1px 0 var(--paper);
    }
    @media (max-width: 767px) { .about-section { margin-top: 20px; padding: 18px 20px; } }
    @media (min-width: 768px) { .about-section { margin-top: 28px; padding: 24px 28px; } }

    .about-section p { font-size: 13px; color: var(--text-light); line-height: 1.8; }
    @media (min-width: 768px) { .about-section p { font-size: 14px; } }

    /* ==========================================
       移动端底部导航栏
       ========================================== */
    .bottom-nav {
      position: fixed;  /* 固定在底部 */
      bottom: 0;
      left: 0;
      right: 0;
      background: var(--card-bg);
      border-top: 1px solid var(--paper);
      display: flex;
      justify-content: space-around;  /* 均匀分布 */
      padding: 6px 0;
      z-index: 100;  /* 层级最高 */
    }

    /* 底部导航项 */
    .nav-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      text-decoration: none;
      color: var(--text-light);
      font-size: 10px;
      padding: 6px 6px;
      border-radius: 6px;
      transition: all 0.15s;
      min-width: 50px;
    }
    .nav-item .icon { font-size: 18px; }
    .nav-item.active { color: var(--accent); }
    .nav-item:active { transform: scale(0.95); }  /* 点击时的按压效果 */

    /* 超小屏幕适配 */
    @media (max-width: 360px) {
      .nav-item { padding: 4px 4px; min-width: 44px; font-size: 9px; }
      .nav-item .icon { font-size: 16px; }
    }
  </style>

  <!-- 全局样式（跨页面生效） -->
  <!-- 这些样式必须在 is:global 块中，否则只对当前组件生效 -->
  <style is:global>
    /* 详情页阅读内容最大宽度 */
    .post-full-content { max-width: 640px; }

    /* 详情页/列表页图片统一宽度约束 */
    .post-full-cover,
    .post-inline-figure {
      display: block;
      width: 100% !important;
      max-width: 640px !important;
      height: auto !important;
      object-fit: contain;
      object-position: center;
      border-radius: 8px;
      border: 1px solid #e8e4dc;
      margin: 0 auto 24px;
      box-sizing: border-box;
    }
    .post-inline-figure { margin: 28px auto; }
    .post-full-cover { margin: 0 auto 24px; }

    /* 图片说明文字 */
    .post-inline-figure-caption {
      display: block;
      text-align: center;
      font-size: 12px;
      color: var(--text-fade);
      margin: -16px auto 24px;
      max-width: 640px;
      font-style: italic;
    }

    /* 详情页正文段落样式（不在 .post 内也能保持样式）*/
    .post-full-content p {
      font-size: 14.5px;
      line-height: 1.95;
      color: var(--text);
      margin-bottom: 16px;
      text-indent: 2em;
    }
    @media (min-width: 768px) { .post-full-content p { font-size: 15.5px; } }
    .post-full-content p strong { color: var(--accent); font-weight: 500; }

    /* ===== 文章列表卡片样式 ===== */
    .post-card-link {
      display: block;
      text-decoration: none;
      color: inherit;
      margin-bottom: 14px;
    }
    .post-card {
      background: var(--card-bg);
      border: 1px solid #c8c2b6;
      border-radius: 6px;
      overflow: hidden;
      transition: border-color .2s ease;
    }
    /* 卡片链接 hover 效果 */
    .post-card-link:hover .post-card { border-color: var(--accent); }
    .post-card-body { padding: 12px 14px 14px; }
    .post-card-title {
      font-size: 16px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 4px;
    }
    .post-card-meta {
      font-size: 11.5px;
      color: var(--text-fade);
      margin-bottom: 6px;
    }
    .post-card-excerpt {
      font-size: 13px;
      color: var(--text-light);
      line-height: 1.6;
      margin-bottom: 8px;
    }
    .post-card-read {
      font-size: 12.5px;
      color: var(--accent);
      font-weight: 500;
    }

    /* 卡片封面图容器 */
    .post-card > .post-card-cover {
      width: 100%;
      height: 160px;
      overflow: hidden;
      border-bottom: 1px solid #e8e4dc;
      background: #f5f3ee;
      display: block;
    }
    .post-card > .post-card-cover img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }
    /* 无封面图时的占位样式 */
    .post-card > .post-card-cover--placeholder {
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 48px;
      color: #c8c2b6;
    }
    @media (min-width: 768px) {
      .post-card > .post-card-cover { height: 200px; }
    }
  </style>
</head>
<body>
  <!-- 主容器：桌面端侧边栏 + 主体，移动端全屏 -->
  <div class="wrapper">
    <!-- ==========================================
         侧边栏（桌面端）
         ========================================== -->
    <aside class="sidebar">
      <!-- 站点 Logo：纯文字 -->
      <a href="/" class="site-logo">
        <div class="site-logo-title">凡耘手记</div>
        <div class="site-logo-sub">一介凡人，闲耘方寸技田</div>
      </a>

      <!-- 导航菜单 -->
      <nav>
        <a href="/" class:list={["nav-item", { active: isActive('/') || isActive('/index') }]}>
          <span class="icon">🏠</span>
          <span>首页</span>
        </a>
        <a href="/teaching" class:list={["nav-item", { active: isActive('/teaching') }]}>
          <span class="icon">🛠️</span>
          <span>杏坛拾器</span>
        </a>
        <a href="/tech" class:list={["nav-item", { active: isActive('/tech') }]}>
          <span class="icon">📱</span>
          <span>数码闲赏</span>
        </a>
        <a href="/ai" class:list={["nav-item", { active: isActive('/ai') }]}>
          <span class="icon">🤖</span>
          <span>新知漫解</span>
        </a>
        <a href="/life" class:list={["nav-item", { active: isActive('/life') }]}>
          <span class="icon">🌿</span>
          <span>岁晚闲书</span>
        </a>
        <a href="/guestbook" class:list={["nav-item", { active: isActive('/guestbook') }]}>
          <span class="icon">💬</span>
          <span>留言板</span>
        </a>
      </nav>
      
      <!-- 底部信息 -->
      <div class="footer">
        📅 建于 2026 · 宁波
      </div>
    </aside>

    <!-- ==========================================
         主内容区
         ========================================== -->
    <main>
      <!-- 桌面端 Banner 大图 -->
      <a href="/" class="site-banner">
        <img src="/banner.jpg" alt="凡耘手记 — 一介凡人，闲耘方寸技田" class="site-banner-img" fetchpriority="high" decoding="async" />
        <div class="site-banner-text">
          <div class="site-banner-title">凡耘手记</div>
          <div class="site-banner-sub">一介凡人，闲耘方寸技田</div>
        </div>
      </a>

      <div class="container">
        <!-- 移动端 Logo（带背景图） -->
        <header>
          <a href="/" class="site-logo site-logo--mobile">
            <img src="/banner.jpg" alt="凡耘手记 — 一介凡人，闲耘方寸技田" class="site-logo-img" />
            <div class="site-logo-text">
              <div class="site-logo-title">凡耘手记</div>
              <div class="site-logo-sub">一介凡人，闲耘方寸技田</div>
            </div>
          </a>
        </header>

        <!-- 页面内容插槽：子组件的内容会插入到这里 -->
        <slot />

        <!-- 分享按钮组件 -->
        <ShareButtons title={title} description={description} type={type} />
      </div>
    </main>
  </div>

  <!-- ==========================================
       移动端底部导航栏
       ========================================== -->
  <nav class="bottom-nav">
    <a href="/" class:list={["nav-item", { active: isActive('/') || isActive('/index') }]}>
      <span class="icon">🏠</span>
      <span>首页</span>
    </a>
    <a href="/teaching" class:list={["nav-item", { active: isActive('/teaching') }]}>
      <span class="icon">🛠️</span>
      <span>杏坛</span>
    </a>
    <a href="/tech" class:list={["nav-item", { active: isActive('/tech') }]}>
      <span class="icon">📱</span>
      <span>数码</span>
    </a>
    <a href="/ai" class:list={["nav-item", { active: isActive('/ai') }]}>
      <span class="icon">🤖</span>
      <span>新知</span>
    </a>
    <a href="/life" class:list={["nav-item", { active: isActive('/life') }]}>
      <span class="icon">🌿</span>
      <span>闲书</span>
    </a>
    <a href="/guestbook" class:list={["nav-item", { active: isActive('/guestbook') }]}>
      <span class="icon">💬</span>
      <span>留言</span>
    </a>
  </nav>

  <!-- ===== 访问统计埋点 ===== -->
  <!-- 使用 sendBeacon 异步发送统计数据，不影响页面性能 -->
  <!-- 即使发送失败也不影响用户浏览 -->
  <script is:inline>
  (function() {
    // 浏览器环境检查
    if (typeof navigator === 'undefined' || !navigator.sendBeacon) return;
    var host = location.hostname;
    // 后台管理页面不统计
    if (host === 'admin.fanren.tech') return;
    // 构造统计数据
    var data = JSON.stringify({
      path: location.pathname + location.search,
      referer: document.referrer || ''
    });
    // 通过 admin.fanren.tech 的 API 发送统计
    navigator.sendBeacon('https://admin.fanren.tech/api/track', new Blob([data], {type: 'application/json'}));
  })();
  </script>
</body>
</html>
