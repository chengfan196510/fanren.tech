---
const { title, description = '程凡的退休闲书博客 - 杏坛拾器、数码体验、新知科普、退休日记' } = Astro.props;

const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path || currentPath === path + '/';
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5">
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=LXGW+WenKai:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      /* 三万风：纸感米白 + 莫兰迪暗色 */
      --bg: #f5f3ee;            /* 主背景：纸感米白 */
      --card-bg: #fbfaf6;       /* 卡片：稍亮的米白 */
      --paper: #e8e4dc;         /* 边线/分割：浅米灰 */
      --text: #1a1a1a;          /* 正文：近黑 */
      --text-light: #6b6660;    /* 次要：暖灰 */
      --text-fade: #9a948a;     /* 三级：淡灰 */
      --accent: #c0392b;        /* 强调：暗红（标题、hover） */
      --accent-soft: #f3d9d3;   /* 强调底色：浅红 */
      --olive: #7a8450;         /* 标签：橄榄绿 */
      --olive-soft: #e6e8d5;
      --ink: #2874a6;           /* 链接：墨蓝 */
      --radius: 8px;            /* 圆角：比之前小，更朴素 */
      --radius-sm: 4px;
      --max-width: 680px;
      --nav-height: 64px;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html { font-size: 16px; -webkit-text-size-adjust: 100%; }

    body {
      font-family: 'LXGW WenKai', -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.85;
      min-height: 100vh;
      /* 一点点纸纹噪点（纯 CSS，SVG 编码） */
      background-image:
        radial-gradient(rgba(0,0,0,0.012) 1px, transparent 1px),
        radial-gradient(rgba(0,0,0,0.008) 1px, transparent 1px);
      background-size: 22px 22px, 11px 11px;
      background-position: 0 0, 7px 7px;
    }

    a { color: var(--ink); text-decoration: none; }
    a:hover { color: var(--accent); }

    /* ========== Desktop：侧边栏 ========== */
    @media (min-width: 768px) {
      .wrapper {
        display: flex;
        max-width: 1080px;
        margin: 0 auto;
        min-height: 100vh;
      }

      .sidebar {
        width: 200px;
        flex-shrink: 0;
        padding: 56px 28px;
        position: sticky;
        top: 0;
        height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .sidebar .avatar {
        width: 64px;
        height: 64px;
        margin-bottom: 14px;
        box-shadow: 1px 1px 0 var(--paper);
      }

      .sidebar .site-title { font-size: 19px; }
      .sidebar .site-desc { font-size: 12px; }
      .sidebar .divider { display: none; }

      .sidebar nav {
        display: flex;
        flex-direction: column;
        gap: 2px;
        margin-top: 28px;
      }

      .sidebar nav a {
        padding: 9px 12px;
        border-radius: var(--radius-sm);
        color: var(--text);
        text-decoration: none;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        transition: all 0.15s;
        border-left: 2px solid transparent;
      }

      .sidebar nav a:hover {
        background: transparent;
        color: var(--accent);
        border-left-color: var(--accent);
        padding-left: 14px;
      }

      .sidebar nav a.active {
        color: var(--accent);
        border-left-color: var(--accent);
        padding-left: 14px;
        font-weight: 500;
      }

      .sidebar nav a .icon { font-size: 16px; opacity: 0.85; }

      .sidebar .footer {
        margin-top: auto;
        font-size: 11px;
        color: var(--text-fade);
        padding-top: 24px;
        border-top: 1px dashed var(--paper);
      }

      main {
        flex: 1;
        padding: 56px 48px;
        border-left: 1px solid var(--paper);
      }

      .container { max-width: var(--max-width); margin: 0; padding: 0; }
      .bottom-nav { display: none !important; }
    }

    /* ========== Mobile：底部导航 ========== */
    @media (max-width: 767px) {
      body { padding-bottom: var(--nav-height); }
      .wrapper { display: block; }
      .sidebar { display: none; }

      .container { max-width: 100%; padding: 0 18px; }

      header { padding: 36px 0 24px; text-align: center; }
      .avatar { width: 60px; height: 60px; font-size: 28px; }
      .site-title { font-size: 22px; }
      .divider {
        height: 1px;
        background: var(--paper);
        margin: 0 -18px 22px;
      }
      main { padding: 0 0 24px; }
      h1 { font-size: 18px; }
      h1 .emoji { font-size: 22px; }
      .card { padding: 16px 18px; margin-bottom: 12px; }
      .card-title { font-size: 15px; }
  
    /* 文章样式：散文（岁晚闲书） */
    .post {
      background: var(--card-bg);
      border: 1px solid var(--paper);
      border-radius: var(--radius);
      box-shadow: 1px 1px 0 var(--paper);
      padding: 22px 26px;
      margin-bottom: 24px;
    }
    @media (max-width: 767px) {
      .post { padding: 18px 18px; }
    }

    .post-title {
      font-size: 19px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    @media (min-width: 768px) { .post-title { font-size: 21px; } }

    .post-meta {
      font-size: 12px;
      color: var(--text-fade);
      margin-bottom: 18px;
      padding-bottom: 14px;
      border-bottom: 1px dashed var(--paper);
    }

    .post-cover {
      width: 100%;
      height: auto;
      border-radius: var(--radius-sm);
      border: 1px solid var(--paper);
      margin-bottom: 18px;
      display: block;
    }

    .post p {
      font-size: 14px;
      line-height: 1.9;
      color: var(--text);
      margin-bottom: 14px;
      text-indent: 2em;
    }
    @media (min-width: 768px) {
      .post p { font-size: 15px; }
    }

    .post p strong { color: var(--accent); font-weight: 500; }


    /* 文章列表卡片（栏目页用） —— 改放全局块，避免 .map 动态渲染时 scoped CID 失效 */

    /* ===== 全局图片兜底（防止图片溢出）===== */
    img { max-width: 100%; height: auto; }

    /* ===== 文章封面图：按真实比例显示，和正文阅读栏同宽（680px） ===== */
    .post-full-cover {
      display: block;
      width: 100% !important;
      max-width: 680px !important;     /* 跟正文 --max-width 一致 */
      height: auto !important;
      object-fit: contain;
      object-position: center;
      border-radius: 8px;
      border: 1px solid #e8e4dc;
      margin: 0 auto 24px;
    }

    /* 卡片封面图 wrapper 样式已移至 <style is:global> 块，避免 .map 动态渲染的 scoped CID 失效问题 */

    /* 单篇文章页 */
    .post-full { padding: 0; }
    .post-back {
      display: inline-block;
      font-size: 13px;
      color: var(--text-light);
      text-decoration: none;
      margin-bottom: 18px;
      padding: 4px 0;
    }
    .post-back:hover { color: var(--accent); }
    .post-back-bottom { margin-top: 28px; padding-top: 18px; border-top: 1px dashed var(--paper); }

    .post-full-title {
      font-size: 22px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 8px;
    }
    @media (min-width: 768px) { .post-full-title { font-size: 26px; } }

    .post-full-meta {
      font-size: 12.5px;
      color: var(--text-fade);
      margin-bottom: 22px;
      padding-bottom: 16px;
      border-bottom: 1px dashed var(--paper);
    }

    @media (min-width: 768px) {
    }

    .post-full-content p {
      font-size: 14.5px;
      line-height: 1.95;
      color: var(--text);
      margin-bottom: 16px;
      text-indent: 2em;
    }
    @media (min-width: 768px) {
      .post-full-content p { font-size: 15.5px; }
    }
    .post-full-content p strong { color: var(--accent); font-weight: 500; }

    .about-section { padding: 18px 20px; }
      .section-title { font-size: 13px; margin: 24px 0 12px; }
      .work-in-progress { padding: 36px 20px; }
      .work-in-progress .emoji { font-size: 40px; }
    }

    @media (min-width: 480px) and (max-width: 767px) {
      .container { padding: 0 22px; }
      header { padding: 44px 0 28px; }
      .avatar { width: 68px; height: 68px; font-size: 30px; }
      .site-title { font-size: 24px; }
      h1 { font-size: 20px; }
      h1 .emoji { font-size: 26px; }
      .card { padding: 18px 20px; margin-bottom: 14px; }
      .card-title { font-size: 16px; }
    }

    /* ========== 通用元素 ========== */
    .avatar {
      width: 64px;
      height: 64px;
      object-fit: cover;
      background: #fff;
      border: 1px solid var(--paper);
      border-radius: 50%;
      display: block;
      margin: 0 auto 14px;
    }

    .site-title { font-weight: 700; margin-bottom: 4px; }
    .site-desc { color: var(--text-light); font-size: 12px; }

    header { text-align: center; }

    h1 {
      font-weight: 700;
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--text);
    }
    h1 .emoji { flex-shrink: 0; }

    .page-desc {
      font-size: 14px;
      color: var(--text-light);
      margin-bottom: 24px;
    }
    @media (min-width: 768px) { .page-desc { margin-bottom: 32px; } }

    /* 卡片：纸感，边线而非阴影 */
    .card {
      background: var(--card-bg);
      border-radius: var(--radius);
      border: 1px solid var(--paper);
      box-shadow: 1px 1px 0 var(--paper);
      transition: all 0.2s;
    }
    .card:hover {
      border-color: var(--accent);
      box-shadow: 2px 2px 0 var(--accent);
      transform: translate(-1px, -1px);
    }

    .card-title { font-weight: 500; margin-bottom: 6px; color: var(--text); }
    .card-desc { font-size: 13px; color: var(--text-light); line-height: 1.65; }

    /* 标签：橄榄绿小章 */
    .card-tag {
      display: inline-block;
      background: var(--olive-soft);
      color: var(--olive);
      padding: 2px 10px;
      border-radius: var(--radius-sm);
      font-size: 11px;
      margin-top: 10px;
      border: 1px solid transparent;
    }

    .section-title {
      color: var(--text-light);
      font-weight: 500;
      padding-left: 4px;
      font-size: 13px;
    }
    .section-title::before { content: '· '; color: var(--accent); }

    .work-in-progress { text-align: center; color: var(--text-light); }
    .work-in-progress .emoji { margin-bottom: 14px; display: block; }
    .work-in-progress h2 { font-size: 16px; color: var(--text); margin-bottom: 6px; }
    .work-in-progress p { font-size: 13px; }


    /* 文章样式：散文（岁晚闲书） */
    .post {
      background: var(--card-bg);
      border: 1px solid var(--paper);
      border-radius: var(--radius);
      box-shadow: 1px 1px 0 var(--paper);
      padding: 22px 26px;
      margin-bottom: 24px;
    }
    @media (max-width: 767px) {
      .post { padding: 18px 18px; }
    }

    .post-title {
      font-size: 19px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    @media (min-width: 768px) { .post-title { font-size: 21px; } }

    .post-meta {
      font-size: 12px;
      color: var(--text-fade);
      margin-bottom: 18px;
      padding-bottom: 14px;
      border-bottom: 1px dashed var(--paper);
    }

    .post-cover {
      width: 100%;
      height: auto;
      border-radius: var(--radius-sm);
      border: 1px solid var(--paper);
      margin-bottom: 18px;
      display: block;
    }

    .post p {
      font-size: 14px;
      line-height: 1.9;
      color: var(--text);
      margin-bottom: 14px;
      text-indent: 2em;
    }
    @media (min-width: 768px) {
      .post p { font-size: 15px; }
    }

    .post p strong { color: var(--accent); font-weight: 500; }


    /* 单篇文章页 */
    .post-full { padding: 0; }
    .post-back {
      display: inline-block;
      font-size: 13px;
      color: var(--text-light);
      text-decoration: none;
      margin-bottom: 18px;
      padding: 4px 0;
    }
    .post-back:hover { color: var(--accent); }
    .post-back-bottom { margin-top: 28px; padding-top: 18px; border-top: 1px dashed var(--paper); }

    .post-full-title {
      font-size: 22px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 8px;
    }
    @media (min-width: 768px) { .post-full-title { font-size: 26px; } }

    .post-full-meta {
      font-size: 12.5px;
      color: var(--text-fade);
      margin-bottom: 22px;
      padding-bottom: 16px;
      border-bottom: 1px dashed var(--paper);
    }

    @media (min-width: 768px) {
    }

    .post-full-content p {
      font-size: 14.5px;
      line-height: 1.95;
      color: var(--text);
      margin-bottom: 16px;
      text-indent: 2em;
    }
    @media (min-width: 768px) {
      .post-full-content p { font-size: 15.5px; }
    }
    .post-full-content p strong { color: var(--accent); font-weight: 500; }

    .about-section {
      background: var(--card-bg);
      border-radius: var(--radius);
      border: 1px solid var(--paper);
      box-shadow: 1px 1px 0 var(--paper);
    }
    @media (max-width: 767px) { .about-section { margin-top: 20px; padding: 18px 20px; } }
    @media (min-width: 768px) { .about-section { margin-top: 28px; padding: 24px 28px; } }

    .about-section p { font-size: 13px; color: var(--text-light); line-height: 1.8; }
    @media (min-width: 768px) { .about-section p { font-size: 14px; } }

    /* 底部导航：白板风，简洁 */
    .bottom-nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: var(--card-bg);
      border-top: 1px solid var(--paper);
      display: flex;
      justify-content: space-around;
      padding: 6px 0;
      z-index: 100;
    }

    .nav-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      text-decoration: none;
      color: var(--text-light);
      font-size: 10px;
      padding: 6px 6px;
      border-radius: 6px;
      transition: all 0.15s;
      min-width: 50px;
    }
    .nav-item .icon { font-size: 18px; }
    .nav-item.active { color: var(--accent); }
    .nav-item:active { transform: scale(0.95); }

    @media (max-width: 360px) {
      .nav-item { padding: 4px 4px; min-width: 44px; font-size: 9px; }
      .nav-item .icon { font-size: 16px; }
    }
  </style>

  <style is:global>
    /* ===== 文章列表卡片（全局块，避开 .map 动态渲染的 scoped CID 失效问题）===== */
    .post-card-link {
      display: block;
      text-decoration: none;
      color: inherit;
      margin-bottom: 14px;
    }
    .post-card {
      background: var(--card-bg);
      border: 1px solid #c8c2b6;
      border-radius: 6px;
      overflow: hidden;
      transition: border-color .2s ease;
    }
    .post-card-link:hover .post-card {
      border-color: var(--accent);
    }
    .post-card-body { padding: 12px 14px 14px; }
    .post-card-title {
      font-size: 16px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 4px;
    }
    .post-card-meta {
      font-size: 11.5px;
      color: var(--text-fade);
      margin-bottom: 6px;
    }
    .post-card-excerpt {
      font-size: 13px;
      color: var(--text-light);
      line-height: 1.6;
      margin-bottom: 8px;
    }
    .post-card-read {
      font-size: 12.5px;
      color: var(--accent);
      font-weight: 500;
    }

    /* ===== 卡片封面图 wrapper（必须 global，否则 scoped 失效）===== */
    .post-card > .post-card-cover {
      width: 100%;
      height: 160px;
      overflow: hidden;
      border-bottom: 1px solid #e8e4dc;
      background: #f5f3ee;
      display: block;
    }
    .post-card > .post-card-cover img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }
    .post-card > .post-card-cover--placeholder {
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 48px;
      color: #c8c2b6;
    }
    @media (min-width: 768px) {
      .post-card > .post-card-cover { height: 200px; }
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <aside class="sidebar">
      <img src="/avatar.jpg" alt="程凡" class="avatar" />
      <h1 class="site-title">凡耘手记</h1>
      <p class="site-desc">一介凡人，闲耘方寸技田</p>
      <div class="divider"></div>
      <nav>
        <a href="/" class:list={["nav-item", { active: isActive('/') || isActive('/index') }]}>
          <span class="icon">🏠</span>
          <span>首页</span>
        </a>
        <a href="/teaching" class:list={["nav-item", { active: isActive('/teaching') }]}>
          <span class="icon">🛠️</span>
          <span>杏坛拾器</span>
        </a>
        <a href="/tech" class:list={["nav-item", { active: isActive('/tech') }]}>
          <span class="icon">📱</span>
          <span>数码闲赏</span>
        </a>
        <a href="/ai" class:list={["nav-item", { active: isActive('/ai') }]}>
          <span class="icon">🤖</span>
          <span>新知漫解</span>
        </a>
        <a href="/life" class:list={["nav-item", { active: isActive('/life') }]}>
          <span class="icon">🌿</span>
          <span>岁晚闲书</span>
        </a>
        <a href="/guestbook" class:list={["nav-item", { active: isActive('/guestbook') }]}>
          <span class="icon">💬</span>
          <span>留言板</span>
        </a>
      </nav>
      <div class="footer">
        📅 建于 2026 · 宁波
      </div>
    </aside>

    <main>
      <div class="container">
        <header>
          <img src="/avatar.jpg" alt="程凡" class="avatar" />
          <h1 class="site-title">凡耘手记</h1>
          <p class="site-desc">一介凡人，闲耘方寸技田</p>
        </header>

        <div class="divider"></div>

        <slot />
      </div>
    </main>
  </div>

  <nav class="bottom-nav">
    <a href="/" class:list={["nav-item", { active: isActive('/') || isActive('/index') }]}>
      <span class="icon">🏠</span>
      <span>首页</span>
    </a>
    <a href="/teaching" class:list={["nav-item", { active: isActive('/teaching') }]}>
      <span class="icon">🛠️</span>
      <span>杏坛</span>
    </a>
    <a href="/tech" class:list={["nav-item", { active: isActive('/tech') }]}>
      <span class="icon">📱</span>
      <span>数码</span>
    </a>
    <a href="/ai" class:list={["nav-item", { active: isActive('/ai') }]}>
      <span class="icon">🤖</span>
      <span>新知</span>
    </a>
    <a href="/life" class:list={["nav-item", { active: isActive('/life') }]}>
      <span class="icon">🌿</span>
      <span>闲书</span>
    </a>
    <a href="/guestbook" class:list={["nav-item", { active: isActive('/guestbook') }]}>
      <span class="icon">💬</span>
      <span>留言</span>
    </a>
  </nav>
</body>
</html>
