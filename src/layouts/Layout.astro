---
const { title, description = '程凡的退休生活博客 - 教学工具、数码体验、AI科普、退休日记' } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | 凡人的技术生活</title>
  <meta name="description" content={description}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=LXGW+WenKai:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #6366F1;
      --secondary: #10B981;
      --accent: #F59E0B;
      --bg: #FAFAFA;
      --card-bg: #FFFFFF;
      --text: #1F2937;
      --text-light: #6B7280;
      --border: #E5E7EB;
      --radius: 20px;
      --shadow: 0 4px 24px rgba(99, 102, 241, 0.08);
      --shadow-hover: 0 12px 40px rgba(99, 102, 241, 0.15);
    }
    
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body {
      font-family: 'LXGW WenKai', -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.8;
      background-image: radial-gradient(#E5E7EB 1px, transparent 1px);
      background-size: 24px 24px;
    }
    
    .container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 24px;
    }
    
    header {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
      padding: 20px 0;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 2px 20px rgba(0,0,0,0.04);
    }
    
    .header-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
    }
    
    .logo {
      display: flex;
      align-items: center;
      gap: 14px;
      text-decoration: none;
      color: var(--text);
    }
    
    .logo-badge {
      background: linear-gradient(135deg, var(--primary), #818CF8);
      color: white;
      padding: 8px 14px;
      border-radius: 12px;
      font-size: 14px;
      font-weight: 500;
      box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
    }
    
    .logo-text {
      font-size: 22px;
      font-weight: 700;
      background: linear-gradient(135deg, var(--text), var(--primary));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    
    .logo-sub {
      font-size: 12px;
      color: var(--text-light);
      margin-top: 2px;
    }
    
    nav {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }
    
    nav a {
      padding: 10px 18px;
      border-radius: 12px;
      text-decoration: none;
      color: var(--text-light);
      font-size: 14px;
      font-weight: 500;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      border: 1px solid transparent;
    }
    
    nav a:hover {
      background: var(--primary);
      color: white;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
    }
    
    nav a.active {
      background: var(--primary);
      color: white;
      box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
    }
    
    main {
      padding: 48px 0;
      min-height: calc(100vh - 200px);
    }
    
    .hero {
      text-align: center;
      padding: 60px 0 40px;
    }
    
    .hero-badge {
      display: inline-block;
      background: linear-gradient(135deg, #FEF3C7, #FDE68A);
      color: #92400E;
      padding: 8px 20px;
      border-radius: 30px;
      font-size: 13px;
      font-weight: 500;
      margin-bottom: 24px;
      border: 1px solid #FCD34D;
    }
    
    .hero-icon {
      font-size: 72px;
      margin-bottom: 20px;
      display: inline-block;
      animation: float 3s ease-in-out infinite;
    }
    
    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }
    
    .hero h1 {
      font-size: 42px;
      margin-bottom: 16px;
      color: var(--text);
      font-weight: 700;
    }
    
    .hero p {
      font-size: 18px;
      color: var(--text-light);
      max-width: 560px;
      margin: 0 auto;
      line-height: 1.8;
    }
    
    .intro-box {
      background: linear-gradient(135deg, #EEF2FF, #E0E7FF);
      border: 1px solid #C7D2FE;
      border-radius: 20px;
      padding: 28px 32px;
      margin: 40px auto;
      max-width: 640px;
      text-align: left;
    }
    
    .intro-box h2 {
      font-size: 18px;
      color: #4338CA;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    
    .intro-box p {
      font-size: 15px;
      color: #4B5563;
      line-height: 1.8;
    }
    
    .card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 24px;
      margin-top: 48px;
    }
    
    .card {
      background: var(--card-bg);
      border-radius: var(--radius);
      padding: 32px;
      box-shadow: var(--shadow);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      text-decoration: none;
      color: inherit;
      border: 1px solid var(--border);
      position: relative;
      overflow: hidden;
    }
    
    .card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--primary), var(--secondary));
      opacity: 0;
      transition: opacity 0.3s;
    }
    
    .card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-hover);
      border-color: var(--primary);
    }
    
    .card:hover::before {
      opacity: 1;
    }
    
    .card-icon {
      font-size: 48px;
      margin-bottom: 18px;
      display: block;
    }
    
    .card h3 {
      font-size: 20px;
      margin-bottom: 10px;
      color: var(--text);
    }
    
    .card p {
      color: var(--text-light);
      font-size: 14px;
      line-height: 1.7;
    }
    
    .card-tag {
      display: inline-block;
      background: linear-gradient(135deg, var(--primary), #818CF8);
      color: white;
      padding: 5px 14px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 500;
      margin-top: 18px;
    }
    
    .card-tag.green {
      background: linear-gradient(135deg, var(--secondary), #34D399);
    }
    
    .card-tag.amber {
      background: linear-gradient(135deg, var(--accent), #FBBF24);
    }
    
    .card-tag.pink {
      background: linear-gradient(135deg, #EC4899, #F472B6);
    }
    
    .tips {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 24px 28px;
      margin-top: 60px;
    }
    
    .tips h3 {
      font-size: 16px;
      color: var(--text);
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    
    .tips ul {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 8px;
    }
    
    .tips li {
      font-size: 14px;
      color: var(--text-light);
      padding: 8px 0;
    }
    
    .tips li::before {
      content: '✨ ';
    }
    
    footer {
      text-align: center;
      padding: 48px 0;
      color: var(--text-light);
      font-size: 14px;
      border-top: 1px solid var(--border);
      background: var(--card-bg);
    }
    
    footer p {
      margin-bottom: 8px;
    }
    
    footer .heart {
      color: #EF4444;
      animation: pulse 1.5s ease-in-out infinite;
      display: inline-block;
    }
    
    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.2); }
    }
    
    @media (max-width: 640px) {
      .header-content {
        flex-direction: column;
        gap: 16px;
      }
      
      nav {
        justify-content: center;
      }
      
      .hero h1 {
        font-size: 30px;
      }
      
      .card-grid {
        grid-template-columns: 1fr;
      }
      
      .card {
        padding: 24px;
      }
    }
  </style>
</head>
<body>
  <header>
    <div class="container header-content">
      <a href="/" class="logo">
        <div class="logo-badge">🧑‍🏫</div>
        <div>
          <div class="logo-text">凡人的技术生活</div>
          <div class="logo-sub">fanren.tech · 程凡</div>
        </div>
      </a>
      <nav>
        <a href="/">首页</a>
        <a href="/teaching">🛠️ 教学工具</a>
        <a href="/tech">📱 数码控</a>
        <a href="/ai">🤖 AI笔记</a>
        <a href="/life">🌿 生活散</a>
      </nav>
    </div>
  </header>
  
  <main>
    <div class="container">
      <slot />
    </div>
  </main>
  
  <footer>
    <div class="container">
      <p>📅 建于 2026 · 宁波诺丁汉大学附属中学 · 语文老师程凡</p>
      <p>退休不退志，学习无止境 <span class="heart">❤️</span></p>
    </div>
  </footer>
</body>
</html>