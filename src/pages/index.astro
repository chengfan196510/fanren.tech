---
import Layout from '../layouts/Layout.astro';

// ===== 月历组件：获取四个栏目所有文章 =====
const calendarArticleSources = import.meta.glob(
  ['./teaching/*.astro', './tech/*.astro', './ai/*.astro', './life/*.astro'],
  { query: '?raw', import: 'default', eager: true }
);

function parseFrontmatter(raw: string) {
  const fm: Record<string, any> = { title: '', date: '', tags: [], excerpt: '', cover: '', hidden: false };
  const jsMatch = raw.match(/const\s+frontmatter\s*=\s*(\{[\s\S]*?\})\s*;/);
  if (jsMatch) {
    try {
      return { ...fm, ...(new Function(`return (${jsMatch[1]})`)()) };
    } catch (e) {
      console.error('frontmatter parse error (js)', e);
    }
  }
  const yamlMatch = raw.match(/^---\s*\n([\s\S]*?)\n---/);
  if (yamlMatch) {
    const lines = yamlMatch[1].split('\n');
    for (const line of lines) {
      const m = line.match(/^(\w+):\s*(.*)$/);
      if (!m) continue;
      const key = m[1].trim();
      let val = m[2].trim();
      val = val.replace(/^["']|["']$/g, '');
      if (key === 'tags' && val.startsWith('[')) {
        try { fm.tags = JSON.parse(val); } catch { fm.tags = []; }
      } else if (key === 'hidden') {
        fm.hidden = val === 'true';
      } else {
        fm[key] = val;
      }
    }
    return fm;
  }
  return fm;
}

const calendarCategoryMap: Record<string, { name: string; icon: string }> = {
  teaching: { name: '杏坛拾器', icon: '🛠️' },
  tech: { name: '数码闲赏', icon: '📱' },
  ai: { name: '新知漫解', icon: '🤖' },
  life: { name: '岁晚闲书', icon: '🌿' },
};

interface CalendarPost {
  title: string;
  date: string;
  category: string;
  categoryName: string;
  categoryIcon: string;
  url: string;
  excerpt: string;
}

const calendarAllPosts: CalendarPost[] = [];
for (const [path, raw] of Object.entries(calendarArticleSources)) {
  const match = path.match(/\.\/(teaching|tech|ai|life)\/(.+)\.astro$/);
  if (!match) continue;
  const category = match[1];
  const slug = match[2];
  const fm = parseFrontmatter(raw as string);
  if (fm.hidden || !fm.date) continue;
  calendarAllPosts.push({
    title: fm.title || slug,
    date: fm.date,
    category,
    categoryName: calendarCategoryMap[category].name,
    categoryIcon: calendarCategoryMap[category].icon,
    url: `/${category}/${slug}`,
    excerpt: fm.excerpt || '',
  });
}

const calendarPostsByDate: Record<string, CalendarPost[]> = {};
for (const post of calendarAllPosts) {
  if (!calendarPostsByDate[post.date]) {
    calendarPostsByDate[post.date] = [];
  }
  calendarPostsByDate[post.date].push(post);
}

// ===== 月历 SSR：初始月份渲染 =====
const now = new Date();
const initialYear = now.getFullYear();
const initialMonth = now.getMonth();
const todayStr = `${initialYear}-${String(initialMonth + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;

interface CalendarDayCell {
  day: number;
  dateStr: string;
  isOtherMonth: boolean;
  isToday: boolean;
  hasPosts: boolean;
  postCount: number;
}

function generateMonthDays(year: number, month: number): CalendarDayCell[] {
  const cells: CalendarDayCell[] = [];
  const firstDay = new Date(year, month, 1);
  const lastDay = new Date(year, month + 1, 0);
  const startWeekday = firstDay.getDay();
  const daysInMonth = lastDay.getDate();
  const today = new Date();
  const todayDS = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;

  function fmt(y: number, m: number, d: number) {
    return `${y}-${String(m + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
  }

  // 上月末尾
  const prevLast = new Date(year, month, 0).getDate();
  for (let i = startWeekday - 1; i >= 0; i--) {
    const d = prevLast - i;
    const ds = fmt(year, month - 1, d);
    const posts = calendarPostsByDate[ds] || [];
    cells.push({ day: d, dateStr: ds, isOtherMonth: true, isToday: ds === todayDS, hasPosts: posts.length > 0, postCount: posts.length });
  }

  // 当月
  for (let d = 1; d <= daysInMonth; d++) {
    const ds = fmt(year, month, d);
    const posts = calendarPostsByDate[ds] || [];
    cells.push({ day: d, dateStr: ds, isOtherMonth: false, isToday: ds === todayDS, hasPosts: posts.length > 0, postCount: posts.length });
  }

  // 下月补齐到 6 行 (42 格)
  const total = cells.length;
  const remain = total <= 35 ? 35 - total : (total % 7 === 0 ? 0 : 7 - (total % 7));
  for (let d = 1; d <= remain; d++) {
    const ds = fmt(year, month + 1, d);
    const posts = calendarPostsByDate[ds] || [];
    cells.push({ day: d, dateStr: ds, isOtherMonth: true, isToday: ds === todayDS, hasPosts: posts.length > 0, postCount: posts.length });
  }

  return cells;
}

const initialCalendarDays = generateMonthDays(initialYear, initialMonth);
const calendarMonthLabel = `${initialYear}年${initialMonth + 1}月`;
// ===== 月历组件 end =====
---

<Layout
  title="凡耘手记 · 程凡的退休闲耘之地"
  description="一介凡人,闲耘方寸技田。一个即将退休的语文老师 + 智慧办主任,记录教学、数码、AI 和退休生活。"
  image="/avatar.jpg"
>
  <div class="about-section">
    <p>
      半生伏案从教，常年与数字化校园事务相伴，虽不通编程行文，却偏爱以低代码搭建实用工具，在实操里摸索数字门道。步入人生后半程，卸下繁重事务之余，便建起这片小小园地。
    </p>
    <p style="margin-top: 12px;">
      园内四端：甄选实用教学辅助工具，分享多年落地使用心得；把玩各类数码好物，记录日常实测体验；跟进各类新兴AI应用，从入门起步，以自学感悟做通俗科普；闲时随笔落笔，留存往后自在的退休日常。
    </p>
    <p style="margin-top: 12px;">
      不求精深钻研技术，只凭一腔爱好慢慢耕耘。愿以平实分享结识同好，互通经验、彼此交流。方寸小站，既是自我沉淀的自留地，也盼能为需要之人带去点滴参考。
    </p>
  </div>

  <p class="section-title">四个栏目</p>

  <a href="/teaching" class="post-card-link">
    <article class="post-card">
      <div class="post-card-cover">
        <img src="/card-teaching.jpg" alt="杏坛拾器" loading="eager" fetchpriority="high" decoding="async" />
      </div>
      <div class="post-card-body">
        <h2 class="post-card-title">🛠️ 杏坛拾器</h2>
        <div class="post-card-meta">栏目 · 每周更新</div>
        <p class="post-card-excerpt">精选教学工具，分享落地实操心得。</p>
        <span class="post-card-read">进入栏目 →</span>
      </div>
    </article>
  </a>

  <a href="/tech" class="post-card-link">
    <article class="post-card">
      <div class="post-card-cover">
        <img src="/card-tech.jpg" alt="数码闲赏" loading="eager" fetchpriority="high" decoding="async" />
      </div>
      <div class="post-card-body">
        <h2 class="post-card-title">📱 数码闲赏</h2>
        <div class="post-card-meta">栏目 · 个人爱好</div>
        <p class="post-card-excerpt">实测数码好物，记录真机把玩体验。</p>
        <span class="post-card-read">进入栏目 →</span>
      </div>
    </article>
  </a>

  <a href="/ai" class="post-card-link">
    <article class="post-card">
      <div class="post-card-cover">
        <img src="/card-ai.jpg" alt="新知漫解" loading="eager" fetchpriority="high" decoding="async" />
      </div>
      <div class="post-card-body">
        <h2 class="post-card-title">🤖 新知漫解</h2>
        <div class="post-card-meta">栏目 · 边学边写</div>
        <p class="post-card-excerpt">钻研AI新应用，白话科普自学感悟。</p>
        <span class="post-card-read">进入栏目 →</span>
      </div>
    </article>
  </a>

  <a href="/life" class="post-card-link">
    <article class="post-card">
      <div class="post-card-cover">
        <img src="/card-life.jpg" alt="岁晚闲书" loading="eager" fetchpriority="high" decoding="async" />
      </div>
      <div class="post-card-body">
        <h2 class="post-card-title">🌿 岁晚闲书</h2>
        <div class="post-card-meta">栏目 · 记录日常</div>
        <p class="post-card-excerpt">随笔日常点滴，书写悠然退休时光。</p>
        <span class="post-card-read">进入栏目 →</span>
      </div>
    </article>
  </a>

  
  <!-- ============ 文踪月历 ============ -->
  <p class="section-title">文踪月历</p>
  <div class="calendar-container" id="calendarContainer">
    <div class="calendar-header">
      <button class="calendar-nav-btn" id="prevMonth" aria-label="上一月">‹</button>
      <div class="calendar-title" id="calendarTitle">{calendarMonthLabel}</div>
      <button class="calendar-nav-btn" id="nextMonth" aria-label="下一月">›</button>
    </div>
    <div class="calendar-weekdays">
      <span>日</span><span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span>
    </div>
    <div class="calendar-grid" id="calendarGrid">
      {initialCalendarDays.map((cell) => (
        <div
          class:list={[
            'calendar-day',
            { 'other-month': cell.isOtherMonth },
            { 'today': cell.isToday },
            { 'has-posts': cell.hasPosts },
          ]}
          data-date={cell.dateStr}
          title={cell.hasPosts ? `${cell.postCount} 篇文章` : ''}
        >
          {cell.day}
        </div>
      ))}
    </div>
  </div>
  <!-- 当日文章列表弹窗 -->
  <div class="calendar-popup" id="calendarPopup" style="display: none;">
    <div class="calendar-popup-header">
      <span id="popupDate"></span>
      <button class="calendar-popup-close" id="popupClose" aria-label="关闭">×</button>
    </div>
    <div class="calendar-popup-list" id="popupList"></div>
  </div>
  <!-- 月历数据注入 -->
  <div id="calendarData" style="display:none" data-posts={JSON.stringify(calendarPostsByDate)}></div>
  <!-- 月历交互脚本 -->
  <script is:inline>
  (function() {
    var dataEl = document.getElementById('calendarData');
    var postsByDate = {};
    try { postsByDate = JSON.parse(dataEl.dataset.posts); } catch(e) {}
    if (!postsByDate || !Object.keys(postsByDate).length) return;

    var grid = document.getElementById('calendarGrid');
    var titleEl = document.getElementById('calendarTitle');
    var prevBtn = document.getElementById('prevMonth');
    var nextBtn = document.getElementById('nextMonth');
    var popup = document.getElementById('calendarPopup');
    var popupDate = document.getElementById('popupDate');
    var popupList = document.getElementById('popupList');
    var popupClose = document.getElementById('popupClose');

    var now = new Date();
    var currentYear = now.getFullYear();
    var currentMonth = now.getMonth();
    var todayStr = formatDate(now);

    function formatDate(d) {
      var y = d.getFullYear();
      var m = String(d.getMonth() + 1).padStart(2, '0');
      var day = String(d.getDate()).padStart(2, '0');
      return y + '-' + m + '-' + day;
    }

    function formatDateCN(dateStr) {
      var parts = dateStr.split('-');
      return parts[0] + '年' + parseInt(parts[1]) + '月' + parseInt(parts[2]) + '日';
    }

    var initialRendered = true; // SSR 已渲染初始月份

    function bindDayEvents() {
      var cells = grid.querySelectorAll('.calendar-day.has-posts');
      for (var i = 0; i < cells.length; i++) {
        (function(cell) {
          var ds = cell.getAttribute('data-date');
          if (!ds) return;
          cell.addEventListener('click', function() {
            showPopup(ds);
          });
        })(cells[i]);
      }
    }

    function renderCalendar() {
      // 如果是初始且为当月，不需要重绘（节省性能）
      if (initialRendered && currentYear === initialYear && currentMonth === initialMonth) {
        bindDayEvents();
        initialRendered = false;
        return;
      }
      initialRendered = false;
      titleEl.textContent = currentYear + '年' + (currentMonth + 1) + '月';
      grid.innerHTML = '';

      var firstDay = new Date(currentYear, currentMonth, 1);
      var lastDay = new Date(currentYear, currentMonth + 1, 0);
      var startWeekday = firstDay.getDay();
      var daysInMonth = lastDay.getDate();

      // 上月末尾
      var prevMonthLast = new Date(currentYear, currentMonth, 0).getDate();
      for (var i = startWeekday - 1; i >= 0; i--) {
        var d = prevMonthLast - i;
        var ds = formatDate(new Date(currentYear, currentMonth - 1, d));
        addDayCell(d, ds, true);
      }

      // 当月
      for (var d = 1; d <= daysInMonth; d++) {
        var ds = formatDate(new Date(currentYear, currentMonth, d));
        addDayCell(d, ds, false);
      }

      // 下月补齐（保证6行布局稳定）
      var total = startWeekday + daysInMonth;
      var remain = total <= 35 ? 35 - total : (total % 7 === 0 ? 0 : 7 - (total % 7));
      for (var d = 1; d <= remain; d++) {
        var ds = formatDate(new Date(currentYear, currentMonth + 1, d));
        addDayCell(d, ds, true);
      }
    }

    function addDayCell(day, dateStr, isOtherMonth) {
      var cell = document.createElement('div');
      cell.className = 'calendar-day';
      if (isOtherMonth) cell.classList.add('other-month');
      if (dateStr === todayStr) cell.classList.add('today');

      var hasPosts = postsByDate[dateStr] && postsByDate[dateStr].length > 0;
      if (hasPosts) {
        cell.classList.add('has-posts');
        cell.title = postsByDate[dateStr].length + ' 篇文章';
        cell.addEventListener('click', function() {
          showPopup(dateStr);
        });
      }

      cell.textContent = day;
      grid.appendChild(cell);
    }

    function showPopup(dateStr) {
      var posts = postsByDate[dateStr];
      if (!posts || !posts.length) return;

      popupDate.textContent = formatDateCN(dateStr);
      popupList.innerHTML = '';

      for (var i = 0; i < posts.length; i++) {
        var post = posts[i];
        var item = document.createElement('a');
        item.href = post.url;
        item.className = 'calendar-popup-item';

        var title = document.createElement('div');
        title.className = 'calendar-popup-item-title';
        title.textContent = post.title;

        var meta = document.createElement('div');
        meta.className = 'calendar-popup-item-meta';
        meta.innerHTML = '<span class="cat-icon">' + post.categoryIcon + '</span>' + post.categoryName;

        item.appendChild(title);
        item.appendChild(meta);
        popupList.appendChild(item);
      }

      popup.style.display = 'block';
      popup.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function hidePopup() {
      popup.style.display = 'none';
    }

    prevBtn.addEventListener('click', function() {
      currentMonth--;
      if (currentMonth < 0) { currentMonth = 11; currentYear--; }
      renderCalendar();
      hidePopup();
    });

    nextBtn.addEventListener('click', function() {
      currentMonth++;
      if (currentMonth > 11) { currentMonth = 0; currentYear++; }
      renderCalendar();
      hidePopup();
    });

    popupClose.addEventListener('click', hidePopup);

    // 初始：如果 SSR 已渲染当月，直接绑定事件；否则重绘
    if (initialRendered && currentYear === initialYear && currentMonth === initialMonth) {
      bindDayEvents();
      initialRendered = false;
    } else {
      renderCalendar();
    }
  })();
  </script>

  <!-- ============ 物理分割 ============ -->
  <div class="section-divider">
    <div class="section-divider-line"></div>
    <div class="section-divider-content">
      <div class="section-divider-icon">🌐</div>
      <div class="section-divider-title">另一片自留地</div>
      <div class="section-divider-sub">本站之外的内容 · 工作中的沉淀</div>
    </div>
    <div class="section-divider-line"></div>
  </div>

  <!-- ============ 周报卡片:水平布局 + 淡蓝标识 ============ -->
  <a
    href="https://weekly.unncahs.net"
    target="_blank"
    rel="noopener"
    class="external-card-link"
  >
    <article class="external-card">
      <div class="external-card-cover">
        <img src="/card-weekly.jpg" alt="校园信息化周报" loading="lazy" />
        <div class="external-card-badge">↗ 外部站点</div>
      </div>
      <div class="external-card-body">
        <div class="external-card-eyebrow">每周五更新 · 工作周报</div>
        <h2 class="external-card-title">📋 校园信息化周报</h2>
        <p class="external-card-desc">
          每周一份，记录校园信息化的小进展与小思考。
          偶有弯路、有吐槽、有值得分享的小工具。
        </p>
        <div class="external-card-attr">
          宁波诺丁汉大学附属中学 · 智慧办
        </div>
        <div class="external-card-cta">
          前往查看 <span class="external-card-arrow">→</span>
          <span class="external-card-hint">将在新窗口打开</span>
        </div>
      </div>
    </article>
  </a>
</Layout>

<style>
  /* ============ 物理分割 ============ */
  .section-divider {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 56px 0 32px;
  }

  .section-divider-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent 0%,
      var(--border, #d8d2c4) 20%,
      var(--border, #d8d2c4) 80%,
      transparent 100%
    );
  }

  .section-divider-content {
    text-align: center;
    flex-shrink: 0;
  }

  .section-divider-icon {
    font-size: 22px;
    margin-bottom: 4px;
    line-height: 1;
  }

  .section-divider-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.08em;
  }

  .section-divider-sub {
    font-size: 12px;
    color: var(--text-light);
    margin-top: 4px;
    letter-spacing: 0.04em;
  }

  /* ============ 外部站点卡片(水平布局) ============ */
  .external-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .external-card {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 0;
    background: linear-gradient(
      135deg,
      #f5f7fa 0%,
      #eef2f7 100%
    );
    border: 1px solid #c4d1e0;
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease,
      border-color 0.25s ease;
    box-shadow: 0 2px 6px rgba(60, 90, 130, 0.06);
  }

  .external-card-link:hover .external-card {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(60, 90, 130, 0.12);
    border-color: #8aa5c4;
  }

  .external-card-cover {
    position: relative;
    min-height: 260px;
    overflow: hidden;
