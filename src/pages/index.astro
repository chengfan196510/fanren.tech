    font-weight: 400;
  }


  /* ============ 文踪月历 ============ */
  .calendar-container {
    background: var(--card-bg);
    border: 1px solid var(--paper);
    border-radius: var(--radius);
    box-shadow: 1px 1px 0 var(--paper);
    padding: 18px 20px;
    margin-bottom: 8px;
  }
  .calendar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .calendar-nav-btn {
    width: 32px;
    height: 32px;
    border: 1px solid var(--paper);
    background: var(--card-bg);
    border-radius: var(--radius-sm);
    font-size: 18px;
    color: var(--text-light);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s;
    padding: 0;
    line-height: 1;
    font-family: inherit;
  }
  .calendar-nav-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
