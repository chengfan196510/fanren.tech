---
import Layout from '../layouts/Layout.astro';

// 用 import.meta.glob 拿到所有 teaching/ 下的文章
// 用 ?raw 拿到原始文件内容，自己解析 frontmatter
const articleSources = import.meta.glob('./teaching/*.astro', { query: '?raw', import: 'default', eager: true });

function parseFrontmatter(raw) {
  const fm = { title: '', date: '', tags: [], excerpt: '', cover: null, hidden: false };
  const match = raw.match(/const\s+frontmatter\s*=\s*(\{[\s\S]*?\})\s*;/);
  if (match) {
    try {
      return { ...fm, ...(new Function(`return (${match[1]})`)()) };
    } catch (e) {
      console.error('frontmatter parse error', e);
    }
  }
  return fm;
}

const articles = [];
for (const [path, raw] of Object.entries(articleSources)) {
  const slug = path.replace('./teaching/', '').replace('.astro', '');
  const fm = parseFrontmatter(raw);
  if (fm.hidden) continue;
  articles.push({ slug, ...fm });
}

articles.sort((a, b) => (b.date || '').localeCompare(a.date || ''));
---

<Layout
  title="🛠️ 杏坛拾器 · 凡耘手记"
  description="精选教学工具,分享落地实操心得。一个语文老师的教学工具与课堂折腾记录。"
  image="/card-teaching.jpg"
>
  <h1><span class="emoji">🛠️</span> 杏坛拾器</h1>
  <p class="page-desc">精选教学工具，分享落地实操心得</p>

  <div class="about-section">
    <h2>📚 初衷</h2>
    <p>
      当了这么多年语文老师，备课、批作业、出卷子……有太多重复劳动。
      这些年我试了很多工具，有些确实好用。不敢独享，写出来给同行参考。
      不收广告费，纯个人体验。
    </p>
  </div>

  <p class="section-title">📚 已发布文章</p>

  {articles.length === 0 ? (
    <div class="work-in-progress">
      <span class="emoji">🚧</span>
      <h2>还没有文章</h2>
      <p>第一篇正在路上，敬请期待</p>
    </div>
  ) : (
    articles.map((post) => (
      <a href={`/teaching/${post.slug}`} class="post-card-link">
        <article class="post-card">
          {post.cover ? (
            <div class="post-card-cover">
              <img src={post.cover} alt={post.title} />
            </div>
          ) : (
            <div class="post-card-cover post-card-cover--placeholder">
              <span class="emoji">🛠️</span>
            </div>
          )}
          <div class="post-card-body">
            <h2 class="post-card-title">{post.title}</h2>
            <div class="post-card-meta">
              {post.date} · {(post.tags || []).join(' / ')}
            </div>
            <p class="post-card-excerpt">{post.excerpt}</p>
            <span class="post-card-read">阅读全文 →</span>
          </div>
        </article>
      </a>
    ))
  )}

  <div class="work-in-progress">
    <span class="emoji">💡</span>
    <h2>想看什么？</h2>
    <p>留言告诉我，老师工作中哪些地方最想要趁手工具</p>
  </div>
</Layout>
