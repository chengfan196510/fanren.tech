---
/**
 * 数码分类页 - 数码闲赏
 * 
 * 展示所有数码产品评测文章
 * 使用 import.meta.glob 动态获取所有文章并解析 frontmatter
 */
import Layout from '../layouts/Layout.astro';

// =============================================
// 读取并解析文章数据
// =============================================

/**
 * 使用 import.meta.glob 获取所有 tech/ 目录下的文章源文件
 * { query: '?raw', import: 'default' } 表示获取文件的原始内容
 * { eager: true } 表示在构建时就加载所有文件
 */
const articleSources = import.meta.glob('./tech/*.astro', { query: '?raw', import: 'default', eager: true });

/**
 * 解析 frontmatter
 * 
 * @param {string} raw - 文件原始内容
 * @returns {Object} 解析后的 frontmatter 对象
 */
function parseFrontmatter(raw) {
  // 默认值
  const fm = { title: '', date: '', tags: [], excerpt: '', cover: null, hidden: false };
  
  // 从文件中提取 const frontmatter = {...} 这部分内容
  const match = raw.match(/const\s+frontmatter\s*=\s*(\{[\s\S]*?\})\s*;/);
  if (match) {
    try {
      // 使用 Function 动态执行 JS 对象字面量
      return { ...fm, ...(new Function(`return (${match[1]})`)()) };
    } catch (e) {
      console.error('frontmatter parse error', e);
    }
  }
  return fm;
}

/**
 * 遍历所有文章，提取元数据
 */
const articles = [];
for (const [path, raw] of Object.entries(articleSources)) {
  // 从文件路径提取文章 slug
  const slug = path.replace('./tech/', '').replace('.astro', '');
  const fm = parseFrontmatter(raw);
  
  // 跳过隐藏的文章
  if (fm.hidden) continue;
  
  articles.push({ slug, ...fm });
}

/**
 * 按日期倒序排列（最新的在前面）
 */
articles.sort((a, b) => (b.date || '').localeCompare(a.date || ''));
---

<!-- ==========================================
     页面内容
     ========================================== -->
<Layout
  title="📱 数码闲赏 · 凡耘手记"
  description="实测数码好物,记录真机把玩体验。手机、平板、耳机、智能眼镜的雅致心得,不恰饭、不说废话。"
  image="/card-tech.jpg"
>
  <!-- 页面标题 -->
  <h1><span class="emoji">📱</span> 数码闲赏</h1>
  <p class="page-desc">实测数码好物，记录真机把玩体验</p>

  <!-- ==========================================
       关于本栏目说明
       ========================================== -->
  <div class="about-section">
    <h2>📷 数码控自白</h2>
    <p>
      手机、平板、耳机、键盘、智能眼镜……数码产品我见了就想摸。
      不是发烧友，但喜欢折腾。用过都说好的，推荐；踩过坑的，也写。
      写东西的原则：不说废话，不恰饭。
    </p>
  </div>

  <!-- 栏目文章列表标题 -->
  <p class="section-title">📚 已发布文章</p>

  <!-- ==========================================
       文章列表
       ========================================== -->
  {articles.length === 0 ? (
    <!-- 无文章时的占位提示 -->
    <div class="work-in-progress">
      <span class="emoji">🚧</span>
      <h2>还没有文章</h2>
      <p>第一篇正在路上，敬请期待</p>
    </div>
  ) : (
    <!-- 有文章时，渲染文章卡片列表 -->
    articles.map((post) => (
      <a href={`/tech/${post.slug}`} class="post-card-link">
        <article class="post-card">
          {/* 根据是否有封面图显示不同内容 */}
          {post.cover ? (
            <div class="post-card-cover">
              <img src={post.cover} alt={post.title} />
            </div>
          ) : (
            /* 无封面图时显示占位图标 */
            <div class="post-card-cover post-card-cover--placeholder">
              <span class="emoji">📱</span>
            </div>
          )}
          <div class="post-card-body">
            <h2 class="post-card-title">{post.title}</h2>
            <div class="post-card-meta">
              {post.date} · {(post.tags || []).join(' / ')}
            </div>
            <p class="post-card-excerpt">{post.excerpt}</p>
            <span class="post-card-read">阅读全文 →</span>
          </div>
        </article>
      </a>
    ))
  )}

  <!-- ==========================================
       互动提示
       ========================================== -->
  <div class="work-in-progress">
    <span class="emoji">💡</span>
    <h2>想看什么？</h2>
    <p>留言告诉我，你心里种草了哪件数码宝贝</p>
  </div>
</Layout>
