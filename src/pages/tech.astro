---
import Layout from '../layouts/Layout.astro';
---

<Layout title="数码体验" description="数码产品使用体验">
  <section class="hero">
    <div class="hero-icon">📱</div>
    <h1>数码体验</h1>
    <p>数码爱好者，记录科技产品使用心得与评测。</p>
  </section>
  
  <div style="text-align: center; padding: 60px 0;">
    <p style="font-size: 48px; margin-bottom: 20px;">🚧</p>
    <h2 style="font-size: 24px; margin-bottom: 16px;">栏目即将上线</h2>
    <p style="color: var(--text-light);">
      准备好你的教学笔记，我们就可以开始填充内容了。
    </p>
  </div>
</Layout>