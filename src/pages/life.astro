---
import Layout from '../layouts/Layout.astro';

const posts = [
  {
    slug: 'our-home',
    title: '🏠 我们的家',
    date: '2026-06-02',
    tags: ['天伦之乐', '家庭'],
    cover: '/our-home-weekend.jpg',
    excerpt: '说"家"之前，得先交代我们家是怎么个摆法——听着有点散，但这才真实。'
  }
];
---

<Layout title="🌿 岁晚闲书">
  <h1><span class="emoji">🌿</span> 岁晚闲书</h1>
  <p class="page-desc">随笔日常点滴，书写悠然退休时光</p>

  <p class="section-title">天伦之乐</p>

  {posts.map((post) => (
    <a href={`/life/${post.slug}`} class="post-card-link">
      <article class="post-card">
        <img src={post.cover} alt={post.title} class="post-card-cover" />
        <div class="post-card-body">
          <h2 class="post-card-title">{post.title}</h2>
          <div class="post-card-meta">{post.date} · {post.tags.join(' / ')}</div>
          <p class="post-card-excerpt">{post.excerpt}</p>
          <span class="post-card-read">阅读全文 →</span>
        </div>
      </article>
    </a>
  ))}

  <div class="work-in-progress">
    <span class="emoji">🚧</span>
    <h2>更多文章正在路上</h2>
    <p>松果的语录、退休后的日常，慢慢写</p>
  </div>
</Layout>
