---
import Layout from '../layouts/Layout.astro';

// 扫描 src/pages/life/ 下所有 .astro 文章
const modules = import.meta.glob('./life/*.astro', { eager: true });

const posts = Object.entries(modules)
  .map(([path, mod]) => {
    const slug = path.replace('./life/', '').replace(/\.astro$/, '');
    const fm = (mod as any).frontmatter ?? {};
    return {
      slug,
      title: fm.title ?? slug,
      date: fm.date ?? '',
      tags: fm.tags ?? [],
      cover: fm.cover ?? '',
      excerpt: fm.excerpt ?? '',
      hidden: fm.hidden ?? false,
    };
  })
  // 过滤下架文章（hidden: true）
  .filter((p) => !p.hidden)
  // 按日期倒序
  .sort((a, b) => (b.date > a.date ? 1 : b.date < a.date ? -1 : 0));
---

<Layout title="🌿 岁晚闲书">
  <h1><span class="emoji">🌿</span> 岁晚闲书</h1>
  <p class="page-desc">随笔日常点滴，书写悠然退休时光</p>

  {posts.length === 0 ? (
    <div class="work-in-progress">
      <span class="emoji">🚧</span>
      <h2>更多文章正在路上</h2>
      <p>松果的语录、退休后的日常，慢慢写</p>
    </div>
  ) : (
    posts.map((post) => (
      <a href={`/life/${post.slug}`} class="post-card-link">
        <article class="post-card">
          <div class="post-card-cover">
            {post.cover ? (
              <img src={post.cover} alt={post.title} />
            ) : (
              <div class="post-card-cover-fallback">
                <span>🌿</span>
              </div>
            )}
          </div>
          <div class="post-card-body">
            <h2 class="post-card-title">{post.title}</h2>
            <div class="post-card-meta">
              {post.date} · {post.tags.join(' / ')}
            </div>
            <p class="post-card-excerpt">{post.excerpt}</p>
            <span class="post-card-read">阅读全文 →</span>
          </div>
        </article>
      </a>
    ))
  )}

  {posts.length > 0 && (
    <div class="work-in-progress">
      <span class="emoji">💡</span>
      <h2>想看什么？</h2>
      <p>留言板告诉我，或者微信 <code>c_fan_2025</code> 直接说</p>
    </div>
  )}
</Layout>
