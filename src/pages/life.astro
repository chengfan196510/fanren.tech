---
import Layout from '../layouts/Layout.astro';

// 用 ?raw 拿到所有 life/*.astro 的原始内容，自己解析 frontmatter
// 支持两种 frontmatter 形式：
//   1. JS 形式：const frontmatter = { title, date, tags, excerpt, cover, hidden };
//   2. YAML 形式：--- \n title: "..." \n --- （Astro 5 仍可识别 .astro 的 YAML frontmatter）
const articleSources = import.meta.glob('./life/*.astro', { query: '?raw', import: 'default', eager: true });

function parseFrontmatter(raw) {
  const fm = { title: '', date: '', tags: [], excerpt: '', cover: '', hidden: false };
  // 形式 1：JS const frontmatter = { ... }
  const jsMatch = raw.match(/const\s+frontmatter\s*=\s*(\{[\s\S]*?\})\s*;/);
  if (jsMatch) {
    try {
      return { ...fm, ...(new Function(`return (${jsMatch[1]})`)()) };
    } catch (e) {
      console.error('frontmatter parse error (js)', e);
    }
  }
  // 形式 2：YAML frontmatter (--- ... ---)
  const yamlMatch = raw.match(/^---\s*\n([\s\S]*?)\n---/);
  if (yamlMatch) {
    const lines = yamlMatch[1].split('\n');
    for (const line of lines) {
      const m = line.match(/^(\w+):\s*(.*)$/);
      if (!m) continue;
      const key = m[1].trim();
      let val = m[2].trim();
      // 去掉首尾引号
      val = val.replace(/^["']|["']$/g, '');
      if (key === 'tags' && val.startsWith('[')) {
        try { fm.tags = JSON.parse(val); } catch { fm.tags = []; }
      } else if (key === 'hidden') {
        fm.hidden = val === 'true';
      } else {
        fm[key] = val;
      }
    }
    return fm;
  }
  return fm;
}

const posts = [];
for (const [path, raw] of Object.entries(articleSources)) {
  const slug = path.replace('./life/', '').replace(/\.astro$/, '');
  const fm = parseFrontmatter(raw);
  if (fm.hidden) continue;
  posts.push({ slug, ...fm });
}

posts.sort((a, b) => (b.date || '').localeCompare(a.date || ''));
---

<Layout
  title="🌿 岁晚闲书 · 凡耘手记"
  description="随笔日常点滴,书写悠然退休时光。一个即将退休的语文老师,关于家、关于生活、关于自己的小文。"
  image="/card-life.jpg"
>
  <h1><span class="emoji">🌿</span> 岁晚闲书</h1>
  <p class="page-desc">随笔日常点滴，书写悠然退休时光</p>

  {posts.length === 0 ? (
    <div class="work-in-progress">
      <span class="emoji">🚧</span>
      <h2>更多文章正在路上</h2>
      <p>松果的语录、退休后的日常，慢慢写</p>
    </div>
  ) : (
    posts.map((post) => (
      <a href={`/life/${post.slug}`} class="post-card-link">
        <article class="post-card">
          <div class="post-card-cover">
            {post.cover ? (
              <img src={post.cover} alt={post.title} />
            ) : (
              <div class="post-card-cover-fallback">
                <span>🌿</span>
              </div>
            )}
          </div>
          <div class="post-card-body">
            <h2 class="post-card-title">{post.title || post.slug}</h2>
            <div class="post-card-meta">
              {post.date} · {(post.tags || []).join(' / ')}
            </div>
            <p class="post-card-excerpt">{post.excerpt}</p>
            <span class="post-card-read">阅读全文 →</span>
          </div>
        </article>
      </a>
    ))
  )}

  {posts.length > 0 && (
    <div class="work-in-progress">
      <span class="emoji">💡</span>
      <h2>想看什么？</h2>
      <p>留言板告诉我，或者微信 <code>c_fan_2025</code> 直接说</p>
    </div>
  )}
</Layout>
